rectory() as d:\\n  index=str(Path(d)/\\\"index\\\")\\n  for old in commits:\\n   raw=run(repo,\\\"cat-file\\\",\\\"commit\\\",old); headers,msg=raw.split(b\\\"\\\\n\\\\n\\\",1); lines=headers.splitlines(); tree=lines[0].split()[1].decode(); parents=[x.split()[1].decode() for x in lines if x.startswith(b\\\"parent \\\")]\\n   extras=[x for x in lines if not x.startswith((b\\\"tree \\\",b\\\"parent \\\",b\\\"author \\\",b\\\"committer \\\"))]\\n   if extras: raise SystemExit(f\\\"unsupported extra commit header {old}\\\")\\n   env=os.environ.copy();env[\\\"GIT_INDEX_FILE\\\"]=index;run(repo,\\\"read-tree\\\",tree,env=env)\\n   for path in deletes:\\n    subprocess.run([\\\"git\\\",\\\"-C\\\",str(repo),\\\"update-index\\\",\\\"--force-remove\\\",\\\"--\\\",path],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=True)\\n   listed=run(repo,\\\"ls-files\\\",\\\"-s\\\",\\\"-z\\\",env=env).split(b\\\"\\\\0\\\")\\n   for item in listed:\\n    if not item: continue\\n    meta,pathb=item.split(b\\\"\\\\t\\\",1);mode,oid,_stage=meta.decode().split();path=pathb.decode()\\n    record=tx.get((path,oid))\\n    if record:\\n     content=(a.transforms.parent/record[\\\"content_file\\\"]).read_bytes();new_oid=run(repo,\\\"hash-object\\\",\\\"-w\\\",\\\"--stdin\\\",input=content).decode().strip()\\n     if new_oid!=record[\\\"new_git_blob\\\"]: raise SystemExit(f\\\"new blob mismatch {path}\\\")\\n     run(repo,\\\"update-index\\\",\\\"--cacheinfo\\\",mode,new_oid,path,env=env);actions.append({\\\"commit\\\":old,\\\"path\\\":path,\\\"old_blob\\\":oid,\\\"new_blob\\\":new_oid})\\n   new_tree=run(repo,\\\"write-tree\\\",env=env).decode().strip(); author=identity(next(x[7:] for x in lines if x.startswith(b\\\"author \\\")));committer=identity(next(x[10:] for x in lines if x.startswith(b\\\"committer \\\")))\\n   env.update({\\\"GIT_AUTHOR_NAME\\\":author[0],\\\"GIT_AUTHOR_EMAIL\\\":author[1],\\\"GIT_AUTHOR_DATE\\\":author[2]+\\\" \\\"+author[3],\\\"GIT_COMMITTER_NAME\\\":committer[0],\\\"GIT_COMMITTER_EMAIL\\\":committer[1],\\\"GIT_COMMITTER_DATE\\\":committer[2]+\\\" \\\"+committer[3]})\\n   args=[\\\"commit-tree\\\",new_tree];\\n   for parent in parents: args += [\\\"-p\\\",mapping.get(parent,parent)]\\n   new=run(repo,*args,input=msg,env=env).decode().strip();mapping[old]=new\\n  run(repo,\\\"update-ref\\\",a.output_ref,mapping[a.tip])\\n now=run(repo,\\\"for-each-ref\\\",\\\"--format=%(refname) %(objectname)\\\",\\\"refs\\\").decode().splitlines();now=[x for x in now if not x.startswith(\\\"refs/heads/codex/graph-advantage \\\") and not x.startswith(\\\"refs/rewrites/\\\")]\\n if protected!=now: raise SystemExit(\\\"protected refs changed\\\")\\n print(json.dumps({\\\"old_tip\\\":a.tip,\\\"new_tip\\\":mapping[a.tip],\\\"commit_count\\\":len(commits),\\\"map\\\":mapping,\\\"actions\\\":actions},sort_keys=True))\\nif __name__==\\\"__main__\\\":main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a08c65-db0f-7273-a742-0cdace568bd3","create_time":1789063543.437171}}}
