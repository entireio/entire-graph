selected[index].prosePassagePlan = kept\n250\t\t}\n251\t\treturn selected\n252\t}\n253\t\n254\tfunc proseQueryRequestsMultipleParents(q searchQuery) bool {\n255\t\twords := q.words\n256\t\tif words == nil {\n257\t\t\twords = searchQueryWords(q.rawLower)\n258\t\t}\n259\t\tif words[\"else\"] || (words[\"other\"] && words[\"than\"]) {\n260\t\t\treturn true\n261\t\t}\n262\t\twritten := q.wordSequence\n263\t\tif len(written) == 0 {\n264\t\t\twritten = searchQueryWordSequence(q.rawLower)\n265\t\t}\n266\t\tfor index, word := range written {\n267\t\t\tif word == \"which\" && proseWhichListFrame(written, index) {\n268\t\t\t\treturn true\n269\t\t\t}\n270\t\t\tif (word == \"what\" || word == \"where\") && index+1 < len(written) && written[index+1] == \"are\" &&\n271\t\t\t\tsafeASCIIWrittenPlural(written[len(written)-1]) {\n272\t\t\t\treturn true\n273\t\t\t}\n274\t\t}\n275\t\treturn false\n276\t}\n277\t\n278\tfunc proseWhichListFrame(written []string, whichIndex int) bool {\n279\t\tfor headOffset := 1; headOffset <= 2; headOffset++ {\n280\t\t\theadIndex := whichIndex + headOffset\n281\t\t\tpredicateIndex := headIndex + 1\n282\t\t\tif predicateIndex >= len(written) || !safeASCIIWrittenPlural(written[headIndex]) {\n283\t\t\t\tcontinue\n284\t\t\t}\n285\t\t\tif proseListPredicate(written[predicateIndex]) {\n286\t\t\t\treturn true\n287\t\t\t}\n288\t\t}\n289\t\treturn false\n290\t}\n291\t\n292\tfunc proseListPredicate(word string) bool {\n293\t\tswitch word {\n294\t\tcase \"are\", \"contain\", \"cover\", \"describe\", \"have\", \"hold\", \"include\", \"list\", \"match\", \"mention\", \"show\", \"store\", \"use\":\n295\t\t\treturn true\n296\t\tdefault:\n297\t\t\treturn false\n298\t\t}\n299\t}\n300\t\n301\tfunc proseParentHeadCount(q searchQuery, topK int) int {\n302\t\tif topK <= 0 {\n303\t\t\treturn 0\n304\t\t}\n305\t\tif proseQueryRequestsMultipleParents(q) {\n306\t\t\treturn maxInt(1, topK/3)\n307\t\t}\n308\t\treturn (topK + 1) / 2\n309\t}\n310\t\n311\tfunc proseParents(candidates 