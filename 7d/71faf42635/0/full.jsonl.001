{"parentUuid":"0a0d1f55-b36e-42b8-82b8-f6af9ff3dbf1","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/eg-multires/internal/sem/search_multi_resolution_test.go","snippet":"1\tpackage sem\n2\t\n3\timport (\n4\t\t\"strconv\"\n5\t\t\"strings\"\n6\t\t\"testing\"\n7\t)\n8\t\n9\tfunc proseResolutionParent(rank int, path string, line int, snippet string, passages ...SearchPassage) SearchResult {\n10\t\treturn SearchResult{\n11\t\t\tRank: rank, Score: float64(100 - rank), FilePath: path,\n12\t\t\tStartLine: line, EndLine: line, FocusLine: line,\n13\t\t\tSnippetStartLine: line, SnippetEndLine: line, Snippet: snippet,\n14\t\t\tLanguage: \"markdown\",\n15\t\t\tSignals:  []string{proseParentRetrievalSignal},\n16\t\t\tPassages: passages,\n17\t\t}\n18\t}\n19\t\n20\tfunc proseResolutionPassage(line int, snippet string) SearchPassage {\n21\t\treturn SearchPassage{StartLine: line, EndLine: line, FocusLine: line, Snippet: snippet}\n22\t}\n23\t\n24\t// TestExpandProseResolutionPromotesPassagesIntoSpareSlots is the whole point of the pass: the\n25\t// finer regions the ranker already computed become results a consumer that reads `results[]`\n26\t// can see, instead of staying in a field it never asked about.\n27\tfunc TestExpandProseResolutionPromotesPassagesIntoSpareSlots(t *testing.T) {\n28\t\tt.Parallel()\n29\t\tresults := []SearchResult{\n30\t\t\tproseResolutionParent(1, \"sessions/one.md\", 10, \"primary one\",\n31\t\t\t\tproseResolutionPassage(30, \"one alpha\"), proseResolutionPassage(50, \"one beta\")),\n32\t\t}\n33\t\n34\t\texpanded := expandProseResolution(results, 10, 0)\n35\t\n36\t\tif len(expanded) != 3 {\n37\t\t\tt.Fatalf(\"expanded to %d results, want 3\", len(expanded))\n38\t\t}\n39\t\tif len(expanded[0].Passages) != 0 {\n40\t\t\tt.Fatalf(\"promoted passages still attached to the parent: %#v\", expanded[0].Passages)\n41\t\t}\n42\t\tfor index, want := range []struct {\n43\t\t\tline    int\n44\t\t\tsnippet string\n45\t\t}{{30, \"one alpha\"}, {50, \"one beta\"}} {\n46\t\t\tgot := expanded[index+1]\n47\t\t\tif got.Rank != index+2 {\n48\t\t\t\tt.Fatalf(\"rank %d at index %d\", got.Rank, index+1)\n49\t\t\t}\n50\t\t\tif got.FilePath != \"sessions/one.md\" || got.StartLine != want.line || got.EndLine != want.line ||\n51\t\t\t\tgot.SnippetStartLine != want.line || got.SnippetEndLine != want.line || got.FocusLine != want.line {\n52\t\t\t\tt.Fatalf(\"promoted span = %#v, want lines %d\", got, want.line)\n53\t\t\t}\n54\t\t\tif got.Snippet != want.snippet {\n55\t\t\t\tt.Fatalf(\"promoted snippet = %q, want %q\", got.Snippet, want.snippet)\n56\t\t\t}\n57\t\t\tif got.Score != results[0].Score {\n58\t\t\t\tt.Fatalf(\"promoted score = %v, want the parent's %v\", got.Score, results[0].Score)\n59\t\t\t}\n60\t\t\tif !hasSearchSignal(got, proseResolutionSignal) {\n61\t\t\t\tt.Fatalf(\"promoted result is not labelled: %#v\", got.Signals)\n62\t\t\t}\n63\t\t\tif got.SymbolID != \"\" || got.SymbolName != \"\" || got.QualifiedName != \"\" {\n64\t\t\t\tt.Fatalf(\"promoted result claims the parent's symbol identity: %#v\", got)\n65\t\t\t}\n66\t\t}\n67\t\tif len(results[0].Passages) != 2 {\n68\t\t\tt.Fatalf(\"input was mutated: %#v\", results[0].Passages)\n69\t\t}\n70\t}\n71\t\n72\t// TestExpandProseResolutionNeverDisplacesAFile is the property that separates this from --deep:\n73\t// the expansion only ever fills slots the distinct-file ranking left empty.\n74\tfunc TestExpandProseResolutionNeverDisplacesAFile(t *testing.T) {\n75\t\tt.Parallel()\n76\t\tresults := []SearchResult{\n77\t\t\tproseResolutionParent(1, \"sessions/one.md\", 10, \"primary one\", proseResolutionPassage(30, \"one alpha\")),\n78\t\t\tproseResolutionParent(2, \"sessions/two.md\", 20, \"primary two\", proseResolutionPassage(40, \"two alpha\")),\n79\t\t}\n80\t\n81\t\tfor _, topK := range []int{0, 1, 2} {\n82\t\t\texpanded := expandProseResolution(results, topK, 0)\n83\t\t\tif len(expanded) != len(results) {\n84\t\t\t\tt.Fatalf(\"top-k %d expanded to %d results, want %d\", topK, len(expanded), len(results))\n85\t\t\t}\n86\t\t\tif len(expanded[0].Passages) != 1 {\n87\t\t\t\tt.Fatalf(\"top-k %d dropped a passage it did not promote\", topK)\n88\t\t\t}\n89\t\t}\n90\t}\n91\t\n92\t// TestExpandProseResolutionRoundRobinsAcrossParents stops one long document spending every spare\n93\t// slot before a second document has contributed anything.\n94\tfunc TestExpandProseResolutionRoundRobinsAcrossParents(t *testing.T) {\n95\t\tt.Parallel()\n96\t\tresults := []SearchResult{\n97\t\t\tproseResolutionParent(1, \"sessions/one.md\", 10, \"primary one\",\n98\t\t\t\tproseResolutionPassage(30, \"one alpha\"), proseResolutionPassage(50, \"one beta\")),\n99\t\t\tproseResolutionParent(2, \"sessions/two.md\", 20, \"primary two\",\n100\t\t\t\tproseResolutionPassage(40, \"two alpha\")),\n101\t\t}\n102\t\n103\t\texpanded := expandProseResolution(results, 4, 0)\n104\t\n105\t\tif len(expanded) != 4 {\n106\t\t\tt.Fatalf(\"expanded to %d results, want 4\", len(expanded))\n107\t\t}\n108\t\t// Round robin is a property of WHICH passages are promoted, not of where they are printed:\n109\t\t// the second document contributes before the first document contributes twice. `one beta` is\n110\t\t// the first document's depth-2 passage, so its absence is the property under test. (Position\n111\t\t// is no longer meaningful here — results[] is re-sorted by score, so a promotion is reported\n112\t\t// beside its parent rather than at the end.)\n113\t\tpromoted := map[string]bool{}\n114\t\tbySnippet := map[string]SearchResult{}\n115\t\tfor _, result := range expanded {\n116\t\t\tbySnippet[result.Snippet] = result\n117\t\t\tif hasSearchSignal(result, proseResolutionSignal) {\n118\t\t\t\tpromoted[result.Snippet] = true\n119\t\t\t}\n120\t\t}\n121\t\tif !promoted[\"one alpha\"] || !promoted[\"two alpha\"] || promoted[\"one beta\"] {\n122\t\t\tt.Fatalf(\"promoted set = %v, want one alpha and two alpha but not one beta\", promoted)\n123\t\t}\n124\t\tif parent := bySnippet[\"primary one\"]; len(parent.Passages) != 1 || parent.Passages[0].Snippet != \"one beta\" {\n125\t\t\tt.Fatalf(\"unpromoted passage lost from its parent: %#v\", parent.Passages)\n126\t\t}\n127\t\tif parent := bySnippet[\"primary two\"]; len(parent.Passages) != 0 {\n128\t\t\tt.Fatalf(\"promoted passage still attached to its parent: %#v\", parent.Passages)\n129\t\t}\n130\t}\n131\t\n132\t// TestExpandProseResolutionKeepsResultsScoreOrdered pins the invariant results[] advertises.\n133\t// Promotions inherit their parent's score, so appending them left a high-scoring passage sitting\n134\t// behind every low-scoring parent: a consumer taking \"top 20 by score\" got a different set than\n135\t// the first 20 entries, which is precisely the consumer this pass exists to serve.\n136\tfunc TestExpandProseResolutionKeepsResultsScoreOrdered(t *testing.T) {\n137\t\tt.Parallel()\n138\t\tresults := make([]SearchResult, 0, 6)\n139\t\tfor index := 1; index <= 6; index++ {\n140\t\t\tresults = append(results, proseResolutionParent(\n141\t\t\t\tindex, \"sessions/doc-\"+strconv.Itoa(index)+\".md\", index*10,\n142\t\t\t\t\"primary \"+strconv.Itoa(index),\n143\t\t\t\tproseResolutionPassage(index*10+5, \"passage \"+strconv.Itoa(index)),\n144\t\t\t))\n145\t\t}\n146\t\n147\t\texpanded := expandProseResolution(results, 12, 0)\n148\t\n149\t\tif len(expanded) != 12 {\n150\t\t\tt.Fatalf(\"expanded to %d results, want 12\", len(expanded))\n151\t\t}\n152\t\tfor index := 1; index < len(expanded); index++ {\n153\t\t\tif expanded[index].Score > expanded[index-1].Score {\n154\t\t\t\tt.Fatalf(\"results not descending by score: position %d scores %v, position %d scores %v\",\n155\t\t\t\t\tindex-1, expanded[index-1].Score, index, expanded[index].Score)\n156\t\t\t}\n157\t\t}\n158\t\tfor index := range expanded {\n159\t\t\tif expanded[index].Rank != index+1 {\n160\t\t\t\tt.Fatalf(\"rank %d reported at position %d\", expanded[index].Rank, index)\n161\t\t\t}\n162\t\t}\n163\t}\n164\t\n165\t// TestExpandProseResolutionRespectsByteBudget: the expansion is additive, so it is the one pass\n166\t// that could push a payload past the ceiling the fitter already satisfied.\n167\tfunc TestExpandProseResolutionRespectsByteBudget(t *testing.T) {\n168\t\tt.Parallel()\n169\t\tresults := []SearchResult{\n170\t\t\tproseResolutionParent(1, \"sessions/one.md\", 10, \"primary one\",\n171\t\t\t\tproseResolutionPassage(30, strings.Repeat(\"a\", 400)),\n172\t\t\t\tproseResolutionPassage(50, strings.Repeat(\"b\", 400))),\n173\t\t}\n174\t\tbudget := serializedSearchResultBytes(results)\n175\t\n176\t\texpanded := expandProseResolution(results, 10, budget)\n177\t\n178\t\tif serializedSearchResultBytes(expanded) > budget {\n179\t\t\tt.Fatalf(\"expansion breached the budget: %d > %d\", serializedSearchResultBytes(expanded), budget)\n180\t\t}\n181\t\tif len(expanded) != 1 {\n182\t\t\tt.Fatalf(\"expanded to %d results under a tight budget, want 1\", len(expanded))\n183\t\t}\n184\t\tif len(expanded[0].Passages) != 2 {\n185\t\t\tt.Fatalf(\"passages lost when promotion was unaffordable: %#v\", expanded[0].Passages)\n186\t\t}\n\n... [107 lines truncated] ..."},"type":"attachment","uuid":"db31e658-ebf6-45a3-8f40-f1ff56d90441","timestamp":"2026-08-17T03:27:25.771Z","session_id":"fe41fb4b-5221-41ce-afce-6a9fa3dade0c","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/eg-multires","sessionId":"27642e0f-a981-4143-aea0-6f4f8cb34d37","version":"2.1.226","gitBranch":"main","slug":"structured-meandering-origami"}
