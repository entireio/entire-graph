{"parentUuid":"917b7b00-b632-4397-b5f5-698f68cfaeaa","isSidechain":false,"type":"system","subtype":"stop_hook_summary","hookCount":3,"hookInfos":[{"command":"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code stop'","durationMs":3247},{"command":"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-bridge-wake.py"},{"command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"","durationMs":63}],"hookErrors":[],"hookAdditionalContext":[],"preventedContinuation":false,"stopReason":"","hasOutput":false,"level":"suggestion","timestamp":"2026-10-24T20:16:28.442Z","uuid":"24d77a0f-8135-4755-bf71-4b3ca5f55c72","toolUseID":"e87d4ed2-130b-4f55-b2ff-748cd3e913b4","session_id":"6e41b4d8-b432-41b0-bc86-517a25b228fa","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/entire-graph","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.310","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
