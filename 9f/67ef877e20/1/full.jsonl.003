top: 36px; color: var(--muted); font-size: 12.5px; }\n@media (max-width: 560px) { h1 { font-size: 22px; } th, td { padding: 8px; } }\n</style>\n<div class=\"wrap\">\n  <h1>Graph and Brain Process Map</h1>\n  <p class=\"sub\">Every step inside each Entire Graph and Brain process, timed on the latest <span class=\"mono\">main</span>, with the fixes that would speed each one up. Bars are drawn to scale within each process.</p>\n  <div class=\"tabs\" role=\"tablist\">\n    <button class=\"tab\" role=\"tab\" id=\"tab-graph\" aria-controls=\"panel-graph\" aria-selected=\"false\" data-tab=\"graph\">Graph</button>\n    <button class=\"tab\" role=\"tab\" id=\"tab-brain\" aria-controls=\"panel-brain\" aria-selected=\"true\" data-tab=\"brain\">Brain</button>\n  </div>\n  <section id=\"panel-graph\" role=\"tabpanel\" aria-labelledby=\"tab-graph\" hidden>\n    <div class=\"meta\"><span>Build <b class=\"mono\">entire-graph main d4a0c186</b> (v0.5.1-nightly)</span><span>Compared with <b>the 2026-09-18 nightly</b></span><span>Repos <b>entire-graph, cli, entire-brain, entiredb</b></span></div>\n    <div class=\"pending\">\n      <h3>Still being measured</h3>\n      <p style=\"margin:0\">The graph timing run covers every command cold and warm on four repos, a step breakdown of cold index, cold and warm query and the records commands, and CPU profiles on the largest repo. This tab fills in at this same link when it reports, followed by a reviewed fix list.</p>\n    </div>\n  </section>\n---\nbin/\neg/\neg-prof/\ngitshim/\nraw/\nrepos/\nscratch/\nstepmaps/\nPROCESS-MAP.md  10.4K\nprof-patch.py  18.0K\nresults.json  84.0K\nresults.md  9.5K\nstepmap.py  9.5K\ntiming.py  24.3K\n164","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"classifierBoundary":true,"serverClassifierContext":{"request":"683405ee-9578-43e3-a34b-7936f3d71eb8","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"cle