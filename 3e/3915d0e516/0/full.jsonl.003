rs to it, so fixing it means a cleanup on the shared <span class=\"mono\">cli-checkpoints</span> remote. Details in DECISIONS-FOR-YOU.md §6.</td></tr>","+        <tr><td><b>Re-add the Linear connector</b></td><td>Its session is dead; remove and re-add it in claude.ai → Connectors. Three tickets are written and waiting.</td></tr>","         <tr><td><b>Old drafts</b></td><td>Your graph drafts <a href=\"https://github.com/entireio/entire-graph/pull/146\">#146</a> and <a href=\"https://github.com/entireio/entire-graph/pull/300\">#300</a>; community <a href=\"https://github.com/entireio/entire-graph/pull/249\">#249</a> looks superseded.</td></tr>","       </tbody>","     </table></div>"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"84db9cd1-9308-495a-b946-d0d0d62b42bf","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":255},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/cli","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sourceToolAssistantUUID":"93bb7449-3af4-44d8-b6db-2ab18203cc95","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"6e41b4d8-b432-41b0-bc86-517a25b228fa","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-