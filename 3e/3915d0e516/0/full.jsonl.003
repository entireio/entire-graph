's ext:: transport runs its URL as a shell command. The URL can come from","+// the committed manifest, so the fetch must refuse that transport.","+func TestRefreshRefusesExtTransportURL(t *testing.T) {","+  root := t.TempDir()","+  marker := filepath.Join(root, \"ran\")","+  err := refresh(\"demo\", \"v1\", `ext::sh -c \"touch `+marker+`\"`, \"\", filepath.Join(root, \"grammars.json\"), root, false)","+  if err == nil {","+    t.Fatal(\"want fetch error\")","+  }","+  if _, statErr := os.Stat(marker); statErr == nil {","+    t.Fatal(\"an ext:: URL executed its command\")","+  }","+}","+"," func localChangesManifest(t *testing.T, repo, revision string) (manifest, root string) {","   t.Helper()","   root = t.TempDir()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"048e67e4-4434-4ef8-99f0-cbb53202b458","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":268},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sourceToolAssistantUUID":"7adb7906-c915-48af-8afe-aecbaaa29d22","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"323e0f71-94c9-40df-877e-b0c11113f22d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.31