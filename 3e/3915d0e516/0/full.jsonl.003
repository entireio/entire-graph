{"parentUuid":"aabb933c-5fb3-4fd9-b0c2-1690a1e61cef","isSidechain":false,"promptId":"e9718af2-218d-4b30-983b-6052d5adfa69","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JcV1a7k4GWc6krAET2Tcri","type":"tool_result","content":"# classify_license FILE\n#\n# Prints a short SPDX identifier for a license file, based on text that is\n# actually present in it. Unrecognized text prints nothing and the caller\n# fails, so an unreviewed license can never reach NOTICES with a guessed label.\nclassify_license() {\n\tfile=$1\n\tif grep -q 'Apache License' \"$file\" && grep -q 'Version 2.0' \"$file\"; then\n\t\tprintf 'Apache-2.0'\n\t\treturn\n\tfi\n\tif grep -q 'CC0 1.0 Universal' \"$file\"; then\n\t\tprintf 'CC0-1.0'\n\t\treturn\n\tfi\n\tif grep -q 'Redistribution and use in source and binary forms' \"$file\"; then\n\t\tif grep -q 'Neither the name' \"$file\"; then\n\t\t\tprintf 'BSD-3-Clause'\n\t\t\treturn\n\t\tfi\n\t\tprintf 'BSD-2-Clause'\n\t\treturn\n\tfi\n\t# The MIT permission grant is the reliable marker: several upstreams ship\n\t# the MIT body with no \"MIT License\" heading at all.\n\tif grep -q 'Permission is hereby granted, free of charge' \"$file\" &&\n\t\tgrep -q 'without restriction' \"$file\"; then\n\t\tprintf 'MIT'\n\t\treturn\n\tfi\n}\n\nemit_license_file() {\n\tlabel=$1\n\tfile=$2\n\tspdx=$(classify_license \"$file\")\n\tif [ -z \"$spdx\" ]; then\n\t\tprintf '%s: unrecognized license text in %s\\n' \"$0\" \"$file\" >&2\n\t\tprintf 'Classify it in classify_license() before releasing.\\n' >&2\n\t\texit 1\n\tfi\n\tprintf -- '--------------------------------------------------------------------------------\\n' >>\"$out\"\n\tprintf '%s\\n' \"$label\" >>\"$out\"\n\tprintf 'License: %s (verbatim text of %s follows)\\n' \"$spdx\" \"${file##*/}\" >>\"$out\"\n\tprintf -- '--------------------------------------------------------------------------------\\n\\n' >>\"$out\"\n\tcat \"$file\" >>\"$out\"\n\tprintf '\\n' >>\"$out\"\n}\n\ncat >\"$out\" 