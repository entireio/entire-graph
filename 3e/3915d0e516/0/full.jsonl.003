2026-10-25T17:07:32.451Z","realParentDir":"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/gm-all/agentic-swebench/tools"},"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/wt-egcache/internal/gitutil/worktree.go":{"backupFileName":null,"version":215,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/wt-egcache/internal/gitutil"},"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/L1/internal/agentsetup/guide.go":{"backupFileName":null,"version":83,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/L1/internal/agentsetup"},"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/wt-egcache/internal/sem/search_cache_worktree_test.go":{"backupFileName":null,"version":215,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/wt-egcache/internal/sem"},"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/L3b/internal/agentsetup/guide_conditional_read_test.go":{"backupFileName":null,"version":83,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43a4-413e-94c9-bd361b6fafc5/scratchpad/L3b/internal/agentsetup"},"eg-postedit/internal/sem/search_verify.go":{"backupFileName":null,"version":12,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/Users/suhaan/devenv/eg-postedit/internal/sem"},"eg-postedit/internal/cli/root.go":{"backupFileName":null,"version":10,"backupTime":"2026-10-25T17:07:32.451Z","realParentDir":"/Users/suhaan/devenv/eg-postedit/internal/cli"},"/private/tmp/claude-501/-Users-suhaan-devenv/b0108f24-43