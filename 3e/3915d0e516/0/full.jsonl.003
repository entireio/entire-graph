mmars) && grammars[i].Language == g.Language {\n218 │ \t\tgrammars[i] = g\n219 │ \t\treturn grammars\n220 │ \t}\n221 │ \tgrammars = append(grammars, Grammar{})\n222 │ \tcopy(grammars[i+1:], grammars[i:])\n223 │ \tgrammars[i] = g\n224 │ \treturn grammars\n225 │ }","stderr":"\nShell cwd was reset to /Users/suhaan/devenv","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"04b8eee2-15ab-478e-9035-c8c97c1ebf0a","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":268},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"871d27f2-219f-4e03-bd35-be68dd2d4848","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"323e0f71-94c9-40df-877e-b0c11113f22d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.314","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
