ht tool\nfor mutating **Go source** (it kept the worktree clean across four tool-code\nmutations in the same session), so the method is sound for half the job and\nsilently useless for the other half.\n\n**How to apply:** mutate Go code with `-overlay`; mutate data files in place\nand restore with `git checkout -- <path>` (verify with `git status --porcelain`\nafter). If a mutation that should break a test does not, suspect the mutation\nreached nothing before suspecting the test — check whether the thing you\nchanged is read at build time or at run time. Related:\n[[verification-harness-false-pass]], [[verified-by-weakening-doctrine]].\n","structuredPatch":[],"originalFile":null,"userModified":false,"memdirStamped":true},"serverClassifierContext":{"request":"155b5ad4-21e8-4c97-a35e-a9814e3f7d0c","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":268},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sourceToolAssistantUUID":"a567cf3e-26fd-42dd-b5a7-4d0bca8438af","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"session_id":"323e0f71-94c9-40df-877e-b0c11113f22d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.314","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
