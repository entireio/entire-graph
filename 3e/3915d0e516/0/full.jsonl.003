ditions,deletions,changedFiles,mergeable 2>/dev/null | python3 -c \"\nimport json,sys\nprs=json.load(sys.stdin)\nforks=[p for p in prs if p['isCrossRepository']]\nprint('open total:',len(prs),'| fork PRs:',len(forks))\nfor p in sorted(forks,key=lambda x:x['number']):\n    print(' ',p['number'],p['author']['login'],p['createdAt'][:10],'+%d/-%d'%(p['additions'],p['deletions']),p['changedFiles'],'files',p['mergeable'],p['title'][:65])\n\"; done","description":"List external fork PRs on brain and cli"}},"serverClassifierRequest":"29b71ab1-fe45-4eed-a33a-f82a1e91c084","apiBlockIndex":1,"requestId":"req_011CgnLg5moPK5aeoZqqBXhK","requestRef":"3c1ae55d-06b8-49eb-a781-f659bcbd0cd0","requestedModel":"claude-opus-5","type":"assistant","uuid":"8965ad4b-8fb4-4044-9d13-6fe482ae132b","timestamp":"2026-11-06T20:54:51.245Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":null,"session_id":"323e0f71-94c9-40df-877e-b0c11113f22d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.314","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
