│ \t\t\tt.Errorf(\"%s: guide shows remember --path but not the path rule %q\", tc.name, rule)\n30 │ \t\t}\n31 │ \t}\n32 │ }\nShell cwd was reset to /Users/suhaan/devenv","is_error":false}]},"uuid":"0c703eba-98dc-41c4-8747-8d603311d64a","timestamp":"2026-11-08T16:40:07.974Z","toolUseResult":{"stdout":".entire/agent-guide.md                             |  5 ++--\n CHANGELOG.md                                       | 10 +++++++\n docs/agent-coordination.md                         | 20 +++++++++-----\n internal/agentsetup/guide.go                       | 13 +++++----\n internal/agentsetup/remember_path_guidance_test.go | 32 ++++++++++++++++++++++\n internal/agentsetup/strict.go                      | 11 ++++----\n 6 files changed, 71 insertions(+), 20 deletions(-)\n=== new test file ===\n 1 │ package agentsetup\n 2 │ \n 3 │ import (\n 4 │ \t\"strings\"\n 5 │ \t\"testing\"\n 6 │ )\n 7 │ \n 8 │ // Every Brain-enabled guide that tells an agent to run `remember --path` also\n 9 │ // says what a path may contain. Without it agents kebab-case a segment, the\n10 │ // path is rejected, and they retry by trial and error (issue #588).\n11 │ func TestBrainGuidesSpellOutTheRememberPathRule(t *testing.T) {\n12 │ \tconst rule = \"lowercase letters, digits and underscores\"\n13 │ \tfor _, tc := range []struct {\n14 │ \t\tname   string\n15 │ \t\tactive map[string]bool\n16 │ \t\tmode   Mode\n17 │ \t}{\n18 │ \t\t{\"brain normal\", map[string]bool{\"brain\": true}, ModeNormal},\n19 │ \t\t{\"combined normal\", map[string]bool{\"brain\": true, \"graph\": true}, ModeNormal},\n20 │ \t\t{\"brain strict\", map[string]bool{\"brain\": true}, ModeStrict},\n21 │ \t\t{\"combined strict\", map[string]bool{\"brain\": true, \"graph\": true}, ModeStrict},\n22 │ \t} {\n23 │ \t\tguide := guideFor(tc.active, tc.mode)\n24 │ \t\tremember := strings.Index(guide, \"entire brain remember\")\n25 │ \t\tif remember < 0 {\n26 │ \t\t\tt.Fatalf(\"%s: guide no longer shows remember\", tc.name)\n27 │ \t\t}\n28 │ \t\tif