{"parentUuid":"eb80b3c1-0b56-4543-88e8-4e31c79910ce","isSidechain":false,"promptId":"cc1505eb-cca7-441c-90f1-4bdb109c2f57","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141ZVaYmVPKv8B2qE5v4oHY","type":"tool_result","content":".entire/agent-guide.md\n  @@ -51,9 +51,10 @@ when you learn something durable that the code does not already state:\n  +Each path segment uses only lowercase letters, digits and underscores: write\n  +project.ci_cache.layout, not project.ci-cache.layout.\n   Omitting --path classifies the memory for you, which requires a supported coding\n  -agent on PATH. Over MCP the same write is the brain_remember tool, which\n  -requires path. Retrieve with recall, and re-check anchors with verify.\n  +agent on PATH. Retrieve with recall, and re-check anchors with verify.\n   \n   Use Brain entities history to connect code changes to earlier checkpoints and\n   sessions. Use Brain memory-informed review and workspace\n  +3 -2\n\nCHANGELOG.md\n  @@ -35,6 +35,16 @@ auto-generated notes on\n  +- The agent guide that `setup` writes when Brain is enabled now says what a\n  +  `remember --path` segment may contain: lowercase letters, digits and\n  +  underscores, no hyphens. It is the rule Brain's own guide states\n  +  (entireio/entire-brain#605).\n  +- The Brain-enabled agent guide no longer says the write is available over MCP\n  +  as the `brain_remember` tool. Brain removed its MCP surface in 0.4.0, and its\n  +  own guide dropped the sentence then. With this and the `--path` rule above,\n  +  Graph renders the same guide text as a Brain that includes\n  +  entireio/entire-brain#605, so a repository's `.entire/agent-guide.md` no\n  +  longer depends on which product ran `setup` last.\n   \n   ### Fixed\n   \n  +10 -0\n\ndocs/agent-coordination.md\n  @@ -177,10 +177,16 @@ repositories, migration, byte stability, invalid metadata, and filesystem\n  -`scripts/test-agent-coordination.py --graph-binary <build> --brain-binary <build>`\n  -in Brain exercises both compiled CLIs with isolated repositories and runtime\n  -stores. It checks single-product initialization despite both plugins being\n  -installed, both orders, read-only preview, migration, metadata errors, runtime\n  -state independence, context selection, and identical shared activation and\n  -installer sources. The host\n  -stub must receive no calls.\n  +Brain's `tools/integration` Go tests run both compiled products in both setup\n  +orders in isolated repositories. They check combined activation, preserved user\n  +text and repeatability, and compare the normal and strict guides each product\n  +renders. After changing `guide.go` or `strict.go` here, run them from an\n  +entire-brain checkout with the matching guide change, pointing the Graph binary\n  +at a build of this tree and requiring exact guide parity:\n  +\n  +```sh\n  +cd <entire-brain checkout>\n  +BRAIN_INTEGRATION_REQUIRED=1 BRAIN_INTEGRATION_REQUIRE_GUIDE_PARITY=1 \\\n  +BRAIN_INTEGRATION_BRAIN_BINARY=<brain build> BRAIN_INTEGRATION_GRAPH_BINARY=<graph build of this tree> \\\n  +go test ./tools/integration -count=1\n  +```\n  +13 -7\n\ninternal/agentsetup/guide.go\n  @@ -39,8 +39,8 @@ var brainReference string\n  -// installed guide depend on initialization order. scripts/test-agent-coordination.py\n  -// (in entire-brain) pins the mirror and render parity across both compiled CLIs.\n  +// installed guide depend on initialization order. Go tests in this package\n  +// cover guide rendering, activation order, and migration.\n   \n   // EVERY GRAPH INVOCATION BELOW ASKS FOR --format agent, AND THAT IS A COST DECISION.\n   //\n  @@ -228,7 +228,7 @@ you do not already know about.\n  -// out. Over MCP the equivalent write is brain_remember, which requires path.\n  +// out.\n   const brainRetrieval = `Questions about why something is the way it is, what was decided, or what was\n   tried before are answered by durable memories. Retrieve them directly; the brief's\n   memories section is a sample, not the search:\n  @@ -247,9 +247,10 @@ when you learn something durable that the code does not already state:\n  +Each path segment uses only lowercase letters, digits and underscores: write\n  +project.ci_cache.layout, not project.ci-cache.layout.\n   Omitting --path classifies the memory for you, which requires a supported coding\n  -agent on PATH. Over MCP the same write is the brain_remember tool, which\n  -requires path. Retrieve with recall, and re-check anchors with verify.\n  +agent on PATH. Retrieve with recall, and re-check anchors with verify.\n   \n   Use Brain entities history to connect code changes to earlier checkpoints and\n   sessions. Use Brain memory-informed review and workspace\n  @@ -304,5 +305,5 @@ const GraphGuide = \"# Entire repository agent guide — Graph\\n\\n\" + graphWorkfl\n  -\treturn \"# Entire repository agent guide — Brain\\n\\n\" + brainWorkflow + \"\\nUse Brain's semantic inspection tools for relevant code questions.\\n\\n\" + commonGuide + \"\\n\" + brainReference\n  +\treturn \"# Entire repository agent guide — Brain\\n\\n\" + brainWorkflow + \"\\nUse Brain's code inspection tools for relevant code questions.\\n\\n\" + commonGuide + \"\\n\" + brainReference\n   }\n  +7 -6\n\ninternal/agentsetup/remember_path_guidance_test.go\n  @@ -0,0 +1,32 @@\n  +package agentsetup\n  +\n  +import (\n  +\t\"strings\"\n  +\t\"testing\"\n  +)\n  +\n  +// Every Brain-enabled guide that tells an agent to run `remember --path` also\n  +// says what a path may contain. Without it agents kebab-case a segment, the\n  +// path is rejected, and they retry by trial and error (issue #588).\n  +func TestBrainGuidesSpellOutTheRememberPathRule(t *testing.T) {\n  +\tconst rule = \"lowercase letters, digits and underscores\"\n  +\tfor _, tc := range []struct {\n  +\t\tname   string\n  +\t\tactive map[string]bool\n  +\t\tmode   Mode\n  +\t}{\n  +\t\t{\"brain normal\", map[string]bool{\"brain\": true}, ModeNormal},\n  +\t\t{\"combined normal\", map[string]bool{\"brain\": true, \"graph\": true}, ModeNormal},\n  +\t\t{\"brain strict\", map[string]bool{\"brain\": true}, ModeStrict},\n  +\t\t{\"combined strict\", map[string]bool{\"brain\": true, \"graph\": true}, ModeStrict},\n  +\t} {\n  +\t\tguide := guideFor(tc.active, tc.mode)\n  +\t\tremember := strings.Index(guide, \"entire brain remember\")\n  +\t\tif remember < 0 {\n  +\t\t\tt.Fatalf(\"%s: guide no longer shows remember\", tc.name)\n  +\t\t}\n  +\t\tif !strings.Contains(guide[remember:], rule) {\n  +\t\t\tt.Errorf(\"%s: guide shows remember --path but not the path rule %q\", tc.name, rule)\n  +\t\t}\n  +\t}\n  +}\n  +32 -0\n\ninternal/agentsetup/strict.go\n  @@ -167,9 +167,10 @@ invariant, a gotcha that cost you time - RECORD it before finishing:\n  +Each path segment uses only lowercase letters, digits and underscores: write\n  +project.ci_cache.layout, not project.ci-cache.layout.\n   Omitting --path classifies the memory for you and requires a supported coding\n  -agent on PATH; pass --path when none is guaranteed. Over MCP the same write is\n  -the brain_remember tool, which requires path. Retrieve with recall and\n  +agent on PATH; pass --path when none is guaranteed. Retrieve with recall and\n   re-check anchors with verify. A memory you author has no source anchor, so verify\n   reports it unverifiable-here - that is expected, not a failure.\n   \n  @@ -195,7 +196,7 @@ func guideFor(active map[string]bool, mode Mode) string {\n  -\t\t\treturn \"# Entire repository agent guide — Brain\\n\\n\" + strictBrainWorkflow + \"\\nUse Brain's semantic inspection tools for relevant code questions.\\n\\n\" + strictCommonGuide + \"\\n\" + brainReference\n  +\t\t\treturn \"# Entire repository agent guide — Brain\\n\\n\" + strictBrainWorkflow + \"\\nUse Brain's code inspection tools for relevant code questions.\\n\\n\" + strictCommonGuide + \"\\n\" + brainReference\n   \t\t}\n   \t\treturn \"# Entire repository agent guide — Graph\\n\\n\" + strictGraphWorkflow + \"\\n\" + strictGraphCommonGuide\n   \t}\n  @@ -212,8 +213,8 @@ func guideFor(active map[string]bool, mode Mode) string {\n  -// actually ships -- the registered MCP tools, the registered commands -- have\n  -// to live in a package that can see both, and internal/cli imports this one.\n  +// actually ships -- the registered commands -- have to live in a package that\n  +// can see both, and internal/cli imports this one.\n   // Checking only the exported BrainGuide/CombinedGuide/GraphGuide would leave\n   // the strict variants, which are a separate copy of the same prose, unguarded.\n   func AllGuides() map[string]string {\n  +6 -5","is_error":false}]},"uuid":"ebd8f231-9544-497d-90e4-b268f7b2edc5","timestamp":"2026-11-06T20:51:59.903Z","toolUseResult":{"stdout":".entire/agent-guide.md\n  @@ -51,9 +51,10 @@ when you learn something durable that the code does not already state:\n  +Each path segment uses only lowercase letters, digits and underscores: write\n  +project.ci_cache.layout, not project.ci-cache.layout.\n   Omitting --path classifies the memory for you, which requires a supported coding\n  -agent on PATH. Over MCP the same write is the brain_remember tool, which\n  -requires path. Retrieve with recall, and re-check anchors with verify.\n  +agent on PATH. Retrieve with recall, and re-check anchors with verify.\n   \n   Use Brain entities history to connect code changes to earlier checkpoints and\n   sessions. Use Brain memory-informed review and workspace\n  +3 -2\n\nCHANGELOG.md\n  @@ -35,6 +35,16 @@ auto-generated notes on\n  +- The agent guide that `setup` writes when Brain is enabled now says what a\n  +  `remember --path` segment may contain: lowercase letters, digits and\n  +  underscores, no hyphens. It is the rule Brain's own guide states\n  +  (entireio/entire-brain#605).\n  +- The Brain-enabled agent guide no longer says the write is available over MCP\n  +  as the `brain_remember` tool. Brain removed its MCP surface in 0.4.0, and its\n