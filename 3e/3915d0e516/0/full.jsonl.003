.get('rows',b.get('tasks',[]))\nfor r in rows:\n  if r.get('id') in ('finding-477-frame-cap','integration-resim-5','brain-prs-green-only-approvals','finding-489-skeptic-pass','export-shrink-on-partial-clone'): print(json.dumps(r)[:900]); print()\n\"; echo ---; gh pr list --repo entireio/entire-brain --author @me --state open --json number,title,isDraft,headRefOid,mergeable --limit 40 | python3 -c \"\nimport json,sys\nfor p in json.load(sys.stdin): print(p['number'],p['isDraft'],p['headRefOid'][:8],p['mergeable'],p['title'][:70])\"","description":"Inspect brain board rows and open brain PRs"}},"wireIngestContext":{"toolu_01M8bf4C1vm9UnREMeZKrL68":{"cwd":"/Users/suhaan/devenv"}},"serverClassifierRequest":"951dddb4-bab1-4bbe-be04-2a166c3caa4a","apiBlockIndex":1,"requestId":"req_011CgPKfzkyJLLvj7vtJei57","requestRef":"ce17eb62-b916-4691-9bed-4c970c50d615","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"6a67f8e9-1c1c-4396-9fff-14b45e32df14","timestamp":"2026-10-25T17:07:55.648Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","session_id":"6e41b4d8-b432-41b0-bc86-517a25b228fa","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.310","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
{"parentUuid":"6a67f8e9-1c1c-4396-9fff-14b45e32df14","isSidechain":false,"promptId":"d0120dab-d2df-4ad6-9e5a-e666df49fa73","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M8bf4C1vm9UnREMeZKrL68","type":"tool_result","content":"{\"id\": \"brain-prs-green-only-approvals\", \"lane\": \"brain\", \"status\": \"blocked\", \"owner\": \"user\", \"source\": \"claude\", \"title\": \"ALL 13 brain PRs final + conflict-free + integration-verified. ONLY Approvals left (and close #493, never merge it). Heads: 473=1f461e47 477=906e8ad3 478=67d3321c 483=fbc2946a 484=8d3f4ce8 489=c0117710\", \"note\": \"Final sweep. 14 PRs open (#473, #474, #476-#484, #488, #489), every one gate-green with Approvals the only failing sub-gate. MERGE ORDER: #479 before #481 (local-metadata builds on the fan-out), and #488 before #489 (#489 is rebased onto it; they touch the same call site in export.go and the composed order is tombstone exemption first, then partition the remainder). Everything else is independent. No conflicts remain for you to resolve -- I rebased rather than leaving one.\"}\n\n{\"id\": \"finding-477-frame-cap\", \"lane\": \"brain\", \"owner\": \"claude\", \"status\": \"doing\", \"title\": \"#477 LOW: readMCPFrame does make([]byte, Content-Length) unbounded - a misbehaving child can force a multi-GB alloc before the timeout. Delegated\"}\n\n{\"id\": \"finding-489-skeptic-pass\", \"lane\": \"brain\", \"owner\": \"claude\", \"status\": \"todo\", \"title\": \"Graph session asked for an INDEPENDENT skeptic pass on #489's fix before it enters the handoff - 'transient git failure publishes a shrunken corpus' is a data-loss shape. Queued behind the agent\"}\n\n{\"id\": \"export-shrink-on-partial-clone\", \"lane\": \"brain\", \"owner\": \"user\", \"status\": \"blocked\", \"title\": \"DESIGN CALL from my skeptic pass on #489: under no-egress on a PROMISOR clone, a fetchable-but-unfetched blob exits 1 silent = indistinguishable from gone-forever, so #489 SKIPS it and there is no partial-shrink guard -> a larger published corpus can be replaced by a smaller one with only a warning. cli IS such a clone (422 blobs fetched by hand this session). Both obvious fixes are WRONG: promisor-means-fetchable re-breaks #489 where it was needed; refuse-if-smaller breaks privacy exclude (#488). Needs a tombstone-aware guard\"}\n\n{\"id\": \"integration-resim-5\", \"lane\": \"brain\", \"status\": \"doing\", \"owner\": \"claude\", \"title\": \"Re-verify combined tree after the findings sweep\", \"note\": \"main a4942dd9, all 13 MERGEABLE, all 13 merge clean in order, combined head 879cac2d pushed to #493 branch for CI. Local full suite running.\"}\n\n---\n489 False 5f15accf MERGEABLE fix(export): a checkpoint whose commit no longer exists must not refus\n488 False 35c308e4 MERGEABLE fix(export): an excluded session must not block the export it was excl\n484 False 9a3aac28 MERGEABLE feat(brief): carry graph's ancestor staleness, and refuse a block that\n483 False 1e257ab9 MERGEABLE fix(history): one transcript too large to read must not refuse the who\n482 False 031fbb5b MERGEABLE fix(setup): exempt every agent's hook config from the dirty gate, not \n481 False 46fe7f3b MERGEABLE perf(export): take checkpoint metadata from the local store, ask Entir\n480 False c796a615 MERGEABLE fix(export): say \"all\" in a way the host honours, and never call a cap\n479 False 2d020c72 MERGEABLE perf(export): read routed checkpoint details several at a time\n478 False 64b7a146 MERGEABLE perf(patterns): scope fact freshness per branch, not across every bran\n477 False d58e9639 MERGEABLE feat(doctor): prove the MCP tool surface is reachable, not just declar\n476 False 66348cd2 MERGEABLE perf(history): normalize the text once per call, not once per candidat\n474 False ef41d238 MERGEABLE fix(export): one divergent cached transcript must not abort every expo\n473 False 8f693073 MERGEABLE fix(watch): attribute every daemon log line with its clock and repo","is_error":f