h: %q\", got)\n49 │ \t}\n50 │ \tgrammars, err := loadManifest(manifest)\n51 │ \tif err != nil {\n52 │ \t\tt.Fatal(err)\n53 │ \t}\n54 │ \tif lb := grammars[0].LocalBuild; lb == nil || lb.Patch != \"demo/fix.patch\" {\n55 │ \t\tt.Fatalf(\"local_build not kept: %+v\", grammars[0])\n56 │ \t}\n57 │ }\n58 │ \n59 │ func TestRefreshAppliesPatchInSubdir(t *testing.T) {\n60 │ \trepo := gitRepo(t, map[string]string{\"sub/src/parser.c\": \"#define LANGUAGE_VERSION 14\\n\", \"LICENSE\": \"MIT\\n\"})\n61 │ \tmanifest, root := patchManifest(t, repo, \"sub\", \"demo/fix.patch\", addPatchedLine)\n62 │ \tif err := refresh(options{Lang: \"demo\", Ref: \"HEAD\", ManifestPath: manifest, GrammarsDir: root}); err != nil {\n63 │ \t\tt.Fatal(err)\n64 │ \t}\n65 │ \tif got, _ := os.ReadFile(filepath.Join(root, \"demo\", \"parser.c\")); !strings.Contains(string(got), \"// patched\") {\n66 │ \t\tt.Fatalf(\"vendored parser.c lacks the patch: %q\", got)\n67 │ \t}\n68 │ }\n69 │ \n70 │ func TestRefreshPatchFailureLeavesVendorUntouched(t *testing.T) {\n71 │ \trepo, _ := generatedGrammarRepo(t)\n72 │ \tmismatch := strings.Replace(addPatchedLine, \"VERSION 14\", \"VERSION 13\", 1)\n73 │ \tmanifest, root := patchManifest(t, repo, \"\", \"demo/fix.patch\", mismatch)\n74 │ \tbefore, _ := os.ReadFile(manifest)\n75 │ \terr := refresh(options{Lang: \"demo\", Ref: \"HEAD\", ManifestPath: manifest, GrammarsDir: root})\n76 │ \tif err == nil || !strings.Contains(err.Error(), \"fix.patch\") {\n77 │ \t\tt.Fatalf(\"err = %v; want a failure naming fix.patch\", err)\n78 │ \t}\n79 │ \tif got, _ := os.ReadFile(filepath.Join(root, \"demo\", \"parser.c\")); string(got) != \"old\\n\" {\n80 │ \t\tt.Fatalf(\"parser.c changed after a failed patch: %q\", got)\n81 │ \t}\n82 │ \tif after, _ := os.ReadFile(manifest); string(after) != string(before) {\n83 │ \t\tt.Fatalf(\"manifest changed after a failed patch:\\n%s\", after)\n84 │ \t}\n85 │ }\n86 │ \n87 │ func TestRefreshRejectsUnsafePatchPath(t *testing.T) {\n88 │ \tfor _, patch := range []string{\"../x.patch\", \"/tmp/x.patch\"} {\n89 │ \t\tmanifest, root := patchManifest(t, filepath.Join(t.TempDir(), \"no-such-repo\"), \"\", patch, \"\")\n90 │ \t\terr := refresh(options{Lang: \"demo\", Ref: \"HEAD\", ManifestPath: manifest, GrammarsDir: root})\n91 │ \t\tif err == nil || !strings.Contains(err.Error(), \"patch\") || strings.Contains(err.Error(), \"fetch\") {\n92 │ \t\t\tt.Errorf(\"patch %q: err = %v; want a patch validation error before any fetch\", patch, err)\n93 │ \t\t}\n94 │ \t}\n95 │ }\n\n=== files the swift patch touches ===\n1:diff --git a/grammar.js b/grammar.js\n3:--- a/grammar.js\n4:+++ b/grammar.js\n112:diff --git a/src/scanner.c b/src/scanner.c\n114:--- a/src/scanner.c\n115:+++ b/src/scanner.c\n\n=== patch size ===\n241\nShell cwd was reset to /Users/suhaan/devenv","is_error":false}]},"uuid":"a84c98ec-fed3-450d-8b5f-b43de7a6f5ab","timestamp":"2026-11-08T14:56:32.453Z","toolUseResult":{"stdout":"=== patch_test.go ===\n 1 │ package main\n 2 │ \n 3 │ import (\n 4 │ \t\"os\"\n 5 │ \t\"path/filepath\"\n 6 │ \t\"strings\"\n 7 │ \t\"testing\"\n 8 │ )\n 9 │ \n10 │ const addPatchedLine = `diff --git a/src/parser.c b/src/parser.c\n11 │ --- a/src/parser.c\n12 │ +++ b/src/parser.c\n13 │ @@ -1 +1,2 @@\n14 │  #define LANGUAGE_VERSION 14\n15 │ +// patched\n16 │ `\n17 │ \n18 │ func patchManifest(t *testing.T, repo, subdir, patchPath, patch string) (manifest, root string) {\n19 │ \tt.Helper()\n20 │ \troot = t.TempDir()\n21 │ \tmanifest = filepath.Join(root, \"grammars.json\")\n22 │ \tif err := saveManifest(manifest, []Grammar{{\n23 │ \t\tLanguage:   \"demo\",\n24 │ \t\tURL:        repo,\n25 │ \t\tReference:  \"v0\",\n26 │ \t\tRevision:   \"0000000\",\n27 │ \t\tPath:       subdir,\n28 │ \t\tFiles:      []string{\"LICENSE\", \"parser.c\"},\n29 │ \t\tABI:        14,\n30 │ \t\tLocalBuild: &LocalBuild{Patch: patchPath},\n31 │ \t}}); err != nil {\n32 │ \t\tt.Fatal(err)\n33 │ \t}\n34 │ \tif filepath.IsLocal(patchPath) {\n35 │ \t\twriteTestFile(t, fil