{"parentUuid":"2fbf3829-10dd-489f-9f5d-71d6e3014d18","isSidechain":false,"promptId":"28398f49-5ade-4a59-9174-f5364aaf08a6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M6aFtx62J8XqRQCEWuQWCk","type":"tool_result","content":"  1 │ // Command grammar-refresh vendors a tree-sitter grammar into\n  2 │ // internal/sem/grammars/<lang> from its upstream git repository and records\n  3 │ // where it came from in internal/sem/grammars/grammars.json. It is a\n  4 │ // maintainer tool: it needs the network, and its output is committed, so\n  5 │ // building entire-graph never downloads anything.\n  6 │ //\n  7 │ // Usage:\n  8 │ //\n  9 │ //\tgo run ./cmd/grammar-refresh -lang zig -ref v1.1.2\n 10 │ //\tgo run ./cmd/grammar-refresh -lang fsharp -ref <commit> -path fsharp -allow-local-changes\n 11 │ //\tgo run ./cmd/grammar-refresh -lang newlang -ref v1.0.0 -url https://github.com/o/tree-sitter-newlang\n 12 │ //\tgo run ./cmd/grammar-refresh -lang rust -ref v0.24.2 -url https://github.com/tree-sitter/tree-sitter-rust -generate\n 13 │ //\tgo run ./cmd/grammar-refresh -lang csharp -ref v0.24.0 -tree-sitter-cli 0.26.7\n 14 │ //\n 15 │ // The vendored src/parser.c must be within the ABI range the go-tree-sitter\n 16 │ // runtime loads (minABI-maxABI). A manifest entry's local_build block, or\n 17 │ // -generate, builds it instead of copying it: the entry's patch is applied to\n 18 │ // the checkout, then `npx tree-sitter-cli@<version> generate <args>` runs\n 19 │ // (default --abi maxABI), which needs Node.js. The recorded revision\n 20 │ // regenerates with the recorded version; a new revision uses @latest and\n 21 │ // records the version it ran. -tree-sitter-cli pins one, which is the fix if\n 22 │ // a future tree-sitter release stops generating maxABI. binding.go is never\n 23 │ // touched, so\n 24 │ // a new language still needs one. A grammar that changes parse results needs\n 25 │ // an IdentityRevision bump (internal/sem/provider.go) in the same commit.\n 26 │ //\n 27 │ // A manifest entry with local_changes carries edits that upstream does not\n 28 │ // have, and copying upstream verbatim would discard them. The tool refuses\n 29 │ // such a grammar unless -allow-local-changes is passed, and the maintainer then\n 30 │ // reapplies the steps in the entry's note. Notes survive every refresh.\n 31 │ package main\n 32 │ \n 33 │ import (\n 34 │ \t\"errors\"\n 35 │ \t\"flag\"\n 36 │ \t\"fmt\"\n 37 │ \t\"os\"\n 38 │ \t\"os/exec\"\n 39 │ \t\"path/filepath\"\n 40 │ \t\"regexp\"\n 41 │ \t\"strings\"\n 42 │ )\n 43 │ \n 44 │ func main() {\n 45 │ \tvar (\n 46 │ \t\tlang         = flag.String(\"lang\", \"\", \"grammar directory name under -dir (required)\")\n 47 │ \t\tref          = flag.String(\"ref\", \"\", \"tag, branch or full commit to vendor (required)\")\n 48 │ \t\turl          = flag.String(\"url\", \"\", \"git URL; defaults to the manifest entry\")\n 49 │ \t\tsubdir       = flag.String(\"path\", \"\", \"grammar subdirectory within the repository; defaults to the manifest entry\")\n 50 │ \t\tmanifestPath = flag.String(\"manifest\", \"internal/sem/grammars/grammars.json\", \"path to the grammar manifest\")\n 51 │ \t\tgrammarsDir  = flag.String(\"dir\", \"internal/sem/grammars\", \"directory holding vendored grammars\")\n 52 │ \t\tallowLocal   = flag.Bool(\"allow-local-changes\", false, \"overwrite a grammar whose manifest entry records local changes; they must then be reapplied by hand\")\n 53 │ \t\tgenerateFlag = flag.Bool(\"generate\", false, \"regenerate the parser with tree-sitter-cli (via npx) even if the manifest entry records no local build\")\n 54 │ \t\tcliFlag      = flag.String(\"tree-sitter-cli\", \"\", \"tree-sitter-cli version to generate with; implies -generate\")\n 55 │ \t)\n 56 │ \tflag.Parse()\n 57 │ \tif *lang == \"\" || *ref == \"\" {\n 58 │ \t\tflag.Usage()\n 59 │ \t\tos.Exit(2)\n 60 │ \t}\n 61 │ \to := options{\n 62 │ \t\tLang:              *lang,\n 63 │ \t\tRef:               *ref,\n 64 │ \t\tURL:               *url,\n 65 │ \t\tSubdir:            *subdir,\n 66 │ \t\tManifestPath:      *manifestPath,\n 67 │ \t\tGrammarsDir:       *grammarsDir,\n 68 │ \t\tAllowLocalChanges: *allowLocal,\n 69 │ \t\tGenerate:          *generateFlag,\n 70 │ \t\tTreeSitterCLI:     *cliFlag,\n 71 │ \t}\n 72 │ \tif err := refresh(o); err != nil {\n 73 │ \t\tfmt.Fprintln(os.Stderr, \"grammar-refresh:\", err)\n 74 │ \t\tos.Exit(1)\n 75 │ \t}\n 76 │ }\n 77 │ \n 78 │ var languageNamePattern = regexp.MustCompile(`^[a-z0-9_]+$`)\n 79 │ \n 80 │ // options holds one run's settings. An empty URL or Subdir falls back to the\n 81 │ // manifest entry.\n 82 │ type options struct {\n 83 │ \tLang, Ref, URL, Subdir    string\n 84 │ \tManifestPath, GrammarsDir string\n 85 │ \tAllowLocalChanges         bool\n 86 │ \t// Generate regenerates the parser even when the entry records no\n 87 │ \t// tree-sitter-cli; TreeSitterCLI overrides the version chosen.\n 88 │ \tGenerate      bool\n 89 │ \tTreeSitterCLI string\n 90 │ }\n 91 │ \n 92 │ func refresh(o options) error {\n 93 │ \tlang, ref, url, subdir := o.Lang, o.Ref, o.URL, o.Subdir\n 94 │ \tmanifestPath, grammarsDir := o.ManifestPath, o.GrammarsDir\n 95 │ \tif !languageNamePattern.MatchString(lang) {\n 96 │ \t\treturn fmt.Errorf(\"invalid -lang %q: use the lower-case directory name under %s\", lang, grammarsDir)\n 97 │ \t}\n 98 │ \tif subdir != \"\" && !filepath.IsLocal(subdir) {\n 99 │ \t\treturn fmt.Errorf(\"invalid -path %q: must be a relative path inside the repository\", subdir)\n100 │ \t}\n101 │ \tgrammars, err := loadManifest(manifestPath)\n102 │ \tif err != nil {\n103 │ \t\treturn err\n104 │ \t}\n105 │ \tvar existing Grammar\n106 │ \tfor _, g := range grammars {\n107 │ \t\tif g.Language == lang {\n108 │ \t\t\texisting = g\n109 │ \t\t}\n110 │ \t}\n111 │ \tif url == \"\" {\n112 │ \t\turl = existing.URL\n113 │ \t}\n114 │ \tif url == \"\" {\n115 │ \t\treturn fmt.Errorf(\"%s is not in %s; pass -url\", lang, manifestPath)\n116 │ \t}\n117 │ \tif subdir == \"\" {\n118 │ \t\tsubdir = existing.Path\n119 │ \t}\n120 │ \tif subdir != \"\" && !filepath.IsLocal(subdir) {\n121 │ \t\treturn fmt.Errorf(\"invalid path %q for %s in %s: must be a relative path inside the repository\", subdir, lang, manifestPath)\n122 │ \t}\n123 │ \tif existing.LocalChanges && !o.AllowLocalChanges {\n124 │ \t\treturn fmt.Errorf(\"%s has local changes that a verbatim refresh would discard (%s); pass -allow-local-changes to overwrite it, then reapply them by hand\", lang, existing.Note)\n125 │ \t}\n126 │ \tbuild := existing.LocalBuild\n127 │ \tvar patchFile string\n128 │ \tif build != nil && build.Patch != \"\" {\n129 │ \t\tif !filepath.IsLocal(build.Patch) {\n130 │ \t\t\treturn fmt.Errorf(\"invalid patch %q for %s in %s: must be a relative path inside %s\", build.Patch, lang, manifestPath, grammarsDir)\n131 │ \t\t}\n132 │ \t\tif patchFile, err = filepath.Abs(filepath.Join(grammarsDir, build.Patch)); err != nil {\n133 │ \t\t\treturn err\n134 │ \t\t}\n135 │ \t}\n136 │ \tgenerating := wantsGeneration(existing, o)\n137 │ \tif generating {\n138 │ \t\tif err := findNPX(); err != nil {\n139 │ \t\t\treturn err\n140 │ \t\t}\n141 │ \t}\n142 │ \n143 │ \ttmp, err := os.MkdirTemp(\"\", \"grammar-refresh-\")\n144 │ \tif err != nil {\n145 │ \t\treturn err\n146 │ \t}\n147 │ \tdefer os.RemoveAll(tmp)\n148 │ \tif err := git(tmp, \"init\", \"-q\"); err != nil {\n149 │ \t\treturn err\n150 │ \t}\n151 │ \tif err := git(tmp, \"fetch\", \"-q\", \"--depth\", \"1\", \"--\", url, ref); err != nil {\n152 │ \t\treturn fmt.Errorf(\"fetch %s %s: %w\", url, ref, err)\n153 │ \t}\n154 │ \tif err := git(tmp, \"checkout\", \"-q\", \"FETCH_HEAD\"); err != nil {\n155 │ \t\treturn err\n156 │ \t}\n157 │ \trevision, err := gitOutput(tmp, \"rev-parse\", \"HEAD\")\n158 │ \tif err != nil {\n159 │ \t\treturn err\n160 │ \t}\n161 │ \tif patchFile != \"\" {\n162 │ \t\tif err := applyPatch(tmp, subdir, patchFile); err != nil {\n163 │ \t\t\treturn fmt.Errorf(\"%s at %s: %w\", url, ref, err)\n164 │ \t\t}\n165 │ \t}\n166 │ \tvar version string\n167 │ \tif generating {\n168 │ \t\tgrammarRoot := filepath.Join(tmp, subdir)\n169 │ \t\tif version, err = resolveCLI(grammarRoot, cliVersion(existing, revision, o)); err != nil {\n170 │ \t\t\treturn err\n171 │ \t\t}\n172 │ \t\targs := generateArgs(build)\n173 │ \t\tif err := generate(grammarRoot, version, args); err != nil {\n174 │ \t\t\treturn err\n175 │ \t\t}\n176 │ \t\tnext := LocalBuild{}\n177 │ \t\tif build != nil {\n178 │ \t\t\tnext = *build\n179 │ \t\t}\n180 │ \t\tnext.TreeSitterCLI, next.GenerateArgs = version, args\n181 │ \t\tbuild = &next\n182 │ \t}\n183 │ \n184 │ \tfiles, abi, err := vendor(tmp, subdir, filepath.Join(grammarsDir, lang))\n185 │ \tvar unsupported abiError\n186 │ \tif generating && errors.As(err, &unsupported) {\n187 │ \t\treturn fmt.Errorf(\"%s at %s: %w; tree-sitter-cli %s may no longer generate ABI %d, so pass -tree-sitter-cli <older version>\", url, ref, err, version, maxABI)\n188 │ \t}\n189 │ \tif err != nil {\n190 │ \t\treturn fmt.Errorf(\"%s at %s: %w\", url, ref, err)\n191 │ \t}\n192 │ \tgrammars = upsert(grammars, Grammar{\n193 │ \t\tLanguage:  lang,\n194 │ \t\tURL:       url,\n195 │ \t\tReference: ref,\n196 │ \t\tRevision:  revision,\n197 │ \t\tPath:      subdir,\n198 │ \t\tFiles:     files,\n199 │ \t\tABI:       abi,\n200 │ \t\t// Kept across a revision change: that is when a note's manual steps\n201 │ \t\t// are due. A note the new revision makes obsolete is removed by hand.\n202 │ \t\tLocalChanges: existing.LocalChanges,\n203 │ \t\tNote:         existing.Note,\n204 │ \t\tLocalBuild:   build,\n205 │ \t})\n206 │ \tif err := saveManifest(manifestPath, grammars); err != nil {\n207 │ \t\treturn err\n208 │ \t}\n209 │ \tfmt.Printf(\"vendored %s %s (%s, ABI %d) into %s\\n\", lang, ref, revision[:7], abi, filepath.Join(grammarsDir, lang))\n210 │ \tif existing.LocalChanges {\n211 │ \t\tfmt.Printf(\"warning: %s now lacks its local changes; reapply them before committing\\n\", lang)\n212 │ \t}\n213 │ \tif existing.Note != \"\" {\n214 │ \t\tfmt.Printf(\"note: %s\\n\", existing.Note)\n215 │ \t}\n216 │ \tfmt.Println(\"next: bump IdentityRevision in internal/sem/provider.go if parse results change, and run scripts/gen-notices.sh\")\n217 │ \treturn nil\n218 │ }\n219 │ \n220 │ func git(dir string, args ...string) error {\n221 │ \tcmd := exec.Command(\"git\", args...)\n222 │ \tcmd.Dir = dir\n223 │ \tcmd.Stderr = os.Stderr\n224 │ \treturn cmd.Run()\n225 │ }\n226 │ \n227 │ // applyPatch applies patchFile to the grammar at subdir inside checkout; the\n228 │ // patch's paths are relative to the grammar directory.\n229 │ func applyPatch(checkout, subdir, patchFile string) error {\n230 │ \targs := []string{\"apply\"}\n231 │ \tif subdir != \"\" {\n232 │ \t\targs = append(args, \"--directory=\"+filepath.ToSlash(subdir))\n233 │ \t}\n234 │ \targs = append(args, \"--\", patchFile)\n235 │ \tcmd := exec.Command(\"git\", args...)\n236 │ \tcmd.Dir = checkout\n237 │ \tif out, err := cmd.CombinedOutput(); err != nil {\n238 │ \t\treturn fmt.Errorf(\"apply %s: %w\\n%s\", patchFile, err, strings.TrimSpace(string(out)))\n239 │ \t}\n240 │ \treturn nil\n241 │ }\n242 │ \n243 │ var errNoNPX = errors.New(\"tree-sitter generation needs Node.js; npx was not found on PATH\")\n244 │ \n245 │ // npx and findNPX are variables so tests can stand in for Node.\n246 │ var (\n247 │ \tnpx     = runNPX\n248 │ \tfindNPX = func() error {\n249 │ \t\tif _, err := exec.LookPath(\"npx\"); err != nil {\n250 │ \t\t\treturn errNoNPX\n251 │ \t\t}\n252 │ \t\treturn nil\n253 │ \t}\n254 │ )\n255 │ \n256 │ func runNPX(dir string, args ...string) (string, error) {\n257 │ \tcmd := exec.Command(\"npx\", append([]string{\"--yes\"}, args...)...)\n258 │ \tcmd.Dir = dir\n259 │ \tcmd.Stderr = os.Stderr\n260 │ \tout, err := cmd.Output()\n261 │ \tif errors.Is(err, exec.ErrNotFound) {\n262 │ \t\terr = errNoNPX\n263 │ \t}\n264 │ \treturn strings.TrimSpace(string(out)), err\n265 │ }\n266 │ \n267 │ func gitOutput(dir string, args ...string) (string, error) {\n268 │ \tcmd := exec.Command(\"git\", args...)\n269 │ \tcmd.Dir = dir\n270 │ \tcmd.Stderr = os.Stderr\n271 │ \tout, err := cmd.Output()\n272 │ \treturn strings.TrimSpace(string(out)), err\n273 │ }\nShell cwd was reset to /Users/suhaan/devenv","is_error":false}]},"uuid":"0817b026-ceb6-46cc-b73d-8e0733226c9a","timestamp":"2026-11-08T14:55:15.966Z","toolUseResult":{"stdout":"  1 │ // Command grammar-refresh vendors a tree-sitter grammar into\n  2 │ // internal/sem/grammars/<lang> from its upstream git repository and records\n  3 │ // where it came from in internal/sem/grammars/grammars.json. It is a\n  4 │ // maintainer tool: it needs the network, and its output is committed, so\n  5 │ // building entire-graph never downloads anything.\n  6 │ //\n  7 │ // Usage:\n  8 │ //\n  9 │ //\tgo run ./cmd/grammar-refresh -lang zig -ref v1.1.2\n 10 │ //\tgo run ./cmd/grammar-refresh -lang fsharp -ref <commit> -path fsharp -allow-local-changes\n 11 │ //\tgo run ./cmd/grammar-refresh -lang newlang -ref v1.0.0 -url https://github.com/o/tree-sitter-newlang\n 12 │ //\tgo run ./cmd/grammar-refresh -lang rust -ref v0.24.2 -url https://github.com/tree-sitter/tree-sitter-rust -generate\n 13 │ //\tgo run ./cmd/grammar-refresh -lang csharp -ref v0.24.0 -tree-sitter-cli 0.26.7\n 14 │ //\n 15 │ // The vendored src/parser.c must be within the ABI range the go-tree-sitter\n 16 │ // runtime loads (minABI-maxABI). A manifest entry's local_build block, or\n 17 │ // -generate, builds it instead of copying it: the entry's patch is applied to\n 18 │ // the checkout, then `npx tree-sitter-cli@<version> generate <args>` runs\n 19 │ // (default --abi maxABI), which needs Node.js. The recorded revision\n 20 │ // regenerates with the recorded version; a new revision uses @latest and\n 21 │ // records the version it ran. -tree-sitter-cli pins one, which is the fix if\n 22 │ // a future tree-sitter release stops generating maxABI. binding.go is never\n 23 │ // touched, so\n 24 │ // a new language still needs one. A grammar that changes parse results needs\n 25 │ // an IdentityRevision bump (internal/sem/provider.go) in the same commit.\n 26 │ //\n 27 │ // A manifest entry with local_changes carries edits that upstream does not\n 28 │ // have, and copying upstream verbatim would discard them. The tool refuses\n 29 │ // such a grammar unless -allow-local-changes is passed, and the maintainer then\n 30 │ // reapplies the steps in the entry's note. Notes survive every refresh.\n 31 │ package main\n 32 │ \n 33 │ import (\n 34 │ \t\"errors\"\n 35 │ \t\"flag\"\n 36 │ \t\"fmt\"\n 37 │ \t\"os\"\n 38 │ \t\"os/exec\"\n 39 │ \t\"path/filepath\"\n 40 │ \t\"regexp\"\n 41 │ \t\"strings\"\n 42 │ )\n 43 │ \n 44 │ func main() {\n 45 │ \tvar (\n 46 │ \t\tlang         = flag.String(\"lang\", \"\", \"grammar directory name under -dir (required)\")\n 47 │ \t\tref          = flag.String(\"ref\", \"\", \"tag, branch or full commit to vendor (required)\")\n 48 │ \t\turl          = flag.String(\"url\", \"\", \"git URL; defaults to the manifest entry\")\n 49 │ \t\tsubdir       = flag.String(\"path\", \"\", \"grammar subdirectory within the repository; defaults to the manifest entry\")\n 50 │ \t\tmanifestPath = flag.String(\"manifest\", \"internal/sem/grammars/grammars.json\", \"path to the grammar manifest\")\n 51 │ \t\tgrammarsDir  = flag.String(\"dir\", \"internal/sem/grammars\", \"directory holding vendored grammars\")\n 52 │ \t\tallowLocal   = flag.Bool(\"allow-local-changes\", false, \"overwrite a grammar whose manifest entry records local changes; they must then be reapplied by hand\")\n 53 │ \t\tgenerateFlag = flag.Bool(\"generate\", false, \"regenerate the parser with tree-sitter-cli (via npx) even if the manifest entry records no local build\")\n 54 │ \t\tcliFlag      = flag.String(\"tree-sitter-cli\", \"\", \"tree-sitter-cli version to generate with; implies -generate\")\n 55 │ \t)\n 56 │ \tflag.Parse()\n 57 │ \tif *lang == \"\" || *ref == \"\" {\n 58 │ \t\tflag.Usage()\n 59 │ \t\tos.Exit(2)\n 60 │ \t}\n 61 │ \to := options{\n 62 │ \t\tLang:              *lang,\n 63 │ \t\tRef:               *ref,\n 64 │ \t\tURL:               *url,\n 65 │ \t\tSubdir:            *subdir,\n 66 │ \t\tManifestPath:      *manifestPath,\n 67 │ \t\tGrammarsDir:       *grammarsDir,\n 68 │ \t\tAllowLocalChanges: *allowLocal,\n 69 │ \t\tGenerate:          *generateFlag,\n 70 │ \t\tTreeSitterCLI:     *cliFlag,\n 71 │ \t}\n 72 │ \tif err := refresh(o); err != nil {\n 73 │ \t\tfmt.Fprintln(os.Stderr, \"grammar-refresh:\", err)\n 74 │ \t\tos.Exit(1)\n 75 │ \t}\n 76 │ }\n 77 │ \n 78 │ var languageNamePattern = regexp.MustCompile(`^[a-z0-9_]+$`)\n 79 │ \n 80 │ // options holds one run's settings. An empty URL or Subdir falls back to the\n 81 │ // manifest entry.\n 82 │ type options struct {\n 83 │ \tLang, Ref, URL, Subdir    string\n 84 │ \tManifestPath, GrammarsDir string\n 85 │ \tAllowLocalChanges         bool\n 86 │ \t// Generate regenerates the parser even when the entry records no\n 87 │ \t// tree-sitter-cli; TreeSitterCLI overrides the version chosen.\n 88 │ \tGenerate      bool\n 89 │ \tTreeSitterCLI string\n 90 │ }\n 91 │ \n 92 │ func refresh(o options) error {\n 93 │ \tlang, ref, url, subdir := o.Lang, o.Ref, o.URL, o.Subdir\n 94 │ \tmanifestPath, grammarsDir := o.ManifestPath, o.GrammarsDir\n 95 │ \tif !languageNamePattern.MatchString(lang) {\n 96 │ \t\treturn fmt.Errorf(\"invalid -lang %q: use the lower-case directory name under %s\", lang, grammarsDir)\n 97 │ \t}\n 98 │ \tif subdir != \"\" && !filepath.IsLocal(subdir) {\n 99 │ \t\treturn fmt.Errorf(\"invalid -path %q: must be a relative path inside the repository\", subdir)\n100 │ \t}\n101 │ \tgrammars, err := loadManifest(manifestPath)\n102 │ \tif err != nil {\n103 │ \t\treturn err\n104 │ \t}\n105 │ \tvar existing Grammar\n106 │ \tfor _, g := range grammars {\n107 │ \t\tif g.Language == lang {\n108 │ \t\t\texisting = g\n109 │ \t\t}\n110 │ \t}\n111 │ \tif url == \"\" {\n112 │ \t\turl = existing.URL\n113 │ \t}\n114 │ \tif url == \"\" {\n115 │ \t\treturn fmt.Errorf(\"%s is not in %s; pass -url\", lang, manifestPath)\n116 │ \t}\n117 │ \tif subdir == \"\" {\n118 │ \t\tsubdir = existing.Path\n119 │ \t}\n120 │ \tif subdir != \"\" && !filepath.IsLocal(subdir) {\n121 │ \t\treturn fmt.Errorf(\"invalid path %q for %s in %s: must be a relative path inside the repository\", subdir, lang, manifestPath)\n122 │ \t}\n123 │ \tif existing.LocalChanges && !o.AllowLocalChanges {\n124 │ \t\treturn fmt.Errorf(\"%s has local changes that a verbatim refresh would discard (%s); pass -allow-local-changes to overwrite it, then reapply them by hand\", lang, existing.Note)\n125 │ \t}\n126 │ \tbuild := existing.LocalBuild\n127 │ \tvar patchFile string\n128 │ \tif build != nil && build.Patch != \"\" {\n129 │ \t\tif !filepath.IsLocal(build.Patch) {\n130 │ \t\t\treturn fmt.Errorf(\"invalid patch %q for %s in %s: must be a relative path inside %s\", build.Patch, lang, manifestPath, grammarsDir)\n131 │ \t\t}\n132 │ \t\tif patchFile, err = filepath.Abs(filepath.Join(grammarsDir, build.Patch)); err != nil {\n133 │ \t\t\treturn err\n134 │ \t\t}\n135 │ \t}\n136 │ \tgenerating := wantsGeneration(existing, o)\n137 │ \tif generating {\n138 │ \t\tif err := findNPX(); err != nil {\n139 │ \t\t\treturn err\n140 │ \t\t}\n141 │ \t}\n142 │ \n143 │ \ttmp, err := os.MkdirTemp(\"\", \"grammar-refresh-\")\n144 │ \tif err != nil {\n145 │ \t\treturn err\n146 │ \t}\n147 │ \tdefer os.RemoveAll(tmp)\n148 │ \tif err := git(tmp, \"init\", \"-q\"); err != nil {\n149 │ \t\treturn err\n150 │ \t}\n151 │ \tif err := git(tmp, \"fetch\", \"-q\", \"--depth\", \"1\", \"--\", url, ref); err != nil {\n152 │ \t\treturn fmt.Errorf(\"fetch %s %s: %w\", url, ref, err)\n153 │ \t}\n154 │ \tif err := git(tmp, \"checkout\", \"-q\", \"FETCH_HEAD\"); err != nil {\n155 │ \t\treturn err\n156 │ \t}\n157 │ \trevision, err := gitOutput(tmp, \"rev-parse\", \"HEAD\")\n158 │ \tif err != nil {\n159 │ \t\treturn err\n160 │ \t}\n161 │ \tif patchFile != \"\" {\n162 │ \t\tif err := applyPatch(tmp, subdir, patchFile); err != nil {\n163 │ \t\t\treturn fmt.Errorf(\"%s at %s: %w\", url, ref, err)\n164 │ \t\t}\n165 │ \t}\n166 │ \tvar version string\n167 │ \tif generating {\n168 │ \t\tgrammarRoot := filepath.Join(tmp, subdir)\n169 │ \t\tif version, err = resolveCLI(grammarRoot, cliVersion(existing, revision, o)); err != nil {\n170 │ \t\t\treturn err\n171 │ \t\t}\n172 │ \t\targs := generateArgs(build)\n173 │ \t\tif err := generate(grammarRoot, version, args); err != nil {\n174 │ \t\t\treturn err\n175 │ \t\t}\n176 │ \t\tnext := LocalBuild{}\n177 │ \t\tif build != nil {\n178 │ \t\t\tnext = *build\n179 │ \t\t}\n180 │ \t\tnext.TreeSitterCLI, next.GenerateArgs = version, args\n181 │ \t\tbuild = &next\n182 │ \t}\n183 │ \n184 │ \tfiles, abi, err := vendor(tmp, subdir, filepath.Join(grammarsDir, lang))\n185 │ \tvar unsupported abiError\n186 │ \tif generating && errors.As(err, &unsupported) {\n187 │ \t\treturn fmt.Errorf(\"%s at %s: %w; tree-sitter-cli %s may no longer generate ABI %d, so pass -tree-sitter-cli <older version>\", url, ref, err, version, maxABI)\n188 │ \t}\n189 │ \tif err != nil {\n190 │ \t\treturn fmt.Errorf(\"%s at %s: %w\", url, ref, err)\n191 │ \t}\n192 │ \tgrammars = upsert(grammars, Grammar{\n193 │ \t\tLanguage:  lang,\n194 │ \t\tURL:       url,\n195 │ \t\tReference: ref,\n196 │ \t\tRevision:  revision,\n197 │ \t\tPath:      subdir,\n198 │ \t\tFiles:     files,\n199 │ \t\tABI:       abi,\n200 │ \t\t// Kept across a revision change: that is when a note's manual steps\n201 │ \t\t// are due. A note the new revision makes obsolete is removed by hand.\n202 │ \t\tLocalChanges: existing.LocalChanges,\n203 │ \t\tNote:         existing.Note,\n204 │ \t\tLocalBuild:   build,\n205 │ \t})\n206 │ \tif err := saveManifest(manifestPath, grammars); err != nil {\n207 │ \t\treturn err\n208 │ \t}\n209 │ \tfmt.Printf(\"vendored %s %s (%s, ABI %d) into %s\\n\", lang, ref, revision[:7], abi, filepath.Join(grammarsDir, lang))\n210 │ \tif existing.LocalChanges {\n211 │ \t\tfmt.Printf(\"warning: %s now lacks its local changes; reapply them before committing\\n\", lang)\n212 │ \t}\n213 │ \tif existing.Note != \"\" {\n214 │ \t\tfmt.Printf(\"note: %s\\n\", existing.Note)\n215 │ \t}\n216 │ \tfmt.Println(\"next: bump IdentityRevision in internal/sem/provider.go if parse results change, and run scripts/gen-notices.sh\")\n217 │ \treturn nil\n218 │ }\n219 │ \n220 │ func git(dir string, args ...string) error {\n221 │ \tcmd := exec.Command(\"git\", args...)\n222 │ \tcmd.Dir = dir\n223 │ \tcmd.Stderr = os.Stderr\n224 │ \treturn cmd.Run()\n225 │ }\n226 │ \n227 │ // applyPatch applies patchFile to the grammar at subdir inside checkout; the\n228 │ // patch's paths are relative to the grammar directory.\n229 │ func applyPatch(checkout, subdir, patchFile string) error {\n230 │ \targs := []string{\"apply\"}\n231 │ \tif subdir != \"\" {\n232 │ \t\targs = append(args, \"--directory=\"+filepath.ToSlash(subdir))\n233 │ \t}\n234 │ \targs = append(args, \"--\", patchFile)\n235 │ \tcmd := exec.Command(\"git\", args...)\n236 │ \tcmd.Dir = checkout\n237 │ \tif out, err := cmd.CombinedOutput(); err != nil {\n238 │ \t\treturn fmt.Errorf(\"apply %s: %w\\n%s\", patchFile, err, strings.TrimSpace(string(out)))\n239 │ \t}\n240 │ \treturn nil\n241 │ }\n242 │ \n243 │ var errNoNPX = errors.New(\"tree-sitter generation needs Node.js; npx was not found on PATH\")\n244 │ \n245 │ // npx and findNPX are variables so tests can stand in for Node.\n246 │ var (\n247 │ \tnpx     = runNPX\n248 │ \tfindNPX = func() error {\n249 │ \t\tif _, err := exec.LookPath(\"npx\"); err != nil {\n250 │ \t\t\treturn errNoNPX\n251 │ \t\t}\n252 │ \t\treturn nil\n253 │ \t}\n254 │ )\n255 │ \n256 │ func runNPX(dir string, args ...string) (string, error) {\n257 │ \tcmd := exec.Command(\"npx\", append([]string{\"--yes\"}, args...)...)\n258 │ \tcmd.Dir = dir\n259 │ \tcmd.Stderr = os.Stderr\n260 │ \tout, err := cmd.Output()\n261 │ \tif err