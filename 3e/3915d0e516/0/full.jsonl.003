ved on the full 9\n- [PostToolUseFailure is the right event](posttooluse-failure-is-the-right-event.md) — has `error`; PostToolUse fires on success\n- [Not on main is not unbuilt](not-on-main-is-not-unbuilt.md) — I rebuilt a feature that already existed on my own unmerged bran\n--- lines:\n178","stderr":"\nShell cwd was reset to /Users/suhaan/devenv","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"e6701a58-5207-4dde-b3bd-41efeee9213f","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":268},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"1db34dcf-8104-4499-a97c-d20c737da2b0","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"323e0f71-94c9-40df-877e-b0c11113f22d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"b0108f24-43a4-413e-94c9-bd361b6fafc5","version":"2.1.314","gitBranch":"main","slug":"lets-plan-cool-then-fluffy-walrus"}
