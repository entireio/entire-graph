{"timestamp":"2026-09-04T02:15:54.197Z","ordinal":26311,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":105438704,"cached_input_tokens":104422528,"cache_write_input_tokens":0,"output_tokens":161930,"reasoning_output_tokens":84560,"total_tokens":105600634},"last_token_usage":{"input_tokens":62084,"cached_input_tokens":61824,"cache_write_input_tokens":0,"output_tokens":29,"reasoning_output_tokens":6,"total_tokens":62113},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1788748109},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"664.6256885000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
