{"timestamp":"2026-09-04T01:03:02.221Z","ordinal":25081,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":85167723,"cached_input_tokens":84308736,"cache_write_input_tokens":0,"output_tokens":118896,"reasoning_output_tokens":59956,"total_tokens":85286619},"last_token_usage":{"input_tokens":94066,"cached_input_tokens":93824,"cache_write_input_tokens":0,"output_tokens":81,"reasoning_output_tokens":27,"total_tokens":94147},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1788748109},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"967.8554645000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
