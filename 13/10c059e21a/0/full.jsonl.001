{"timestamp":"2026-09-04T01:43:15.577Z","ordinal":25884,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06a15-9979-74c1-8062-a8d700706ec9","call_id":"call_N4FFD7NpoAoa1EIY8mSTOXrA","output":[{"type":"input_text","text":"Script completed\nWall time 11.8 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"ab6ca3\",\"wall_time_seconds\":11.071486382,\"exit_code\":0,\"original_token_count\":1078,\"output\":\" internal/sem/call_resolution_precision_test.go | 45 ++++++++++++++++++++++++++\\n internal/sem/provider.go                       | 17 ++++++++--\\n 2 files changed, 60 insertions(+), 2 deletions(-)\\ndiff --git a/internal/sem/call_resolution_precision_test.go b/internal/sem/call_resolution_precision_test.go\\nindex ee587924..634d3fc3 100644\\n--- a/internal/sem/call_resolution_precision_test.go\\n+++ b/internal/sem/call_resolution_precision_test.go\\n@@ -950,3 +950,48 @@ class compute:\\n \\t\\t}\\n \\t})\\n }\\n+\\n+func TestPythonFromImportKeywordBoundaryForms(t *testing.T) {\\n+\\tt.Run(\\\"tab-separated keyword remains resolved\\\", func(t *testing.T) {\\n+\\t\\tassertOneImportResolvedComputeEdge(t, pythonFFICallEdges(t, \\\"from frobnicate\\\\timport\\\\tcompute\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"), \\\"app.py:function:plain\\\")\\n+\\t})\\n+\\n+\\tt.Run(\\\"backslash continuation remains resolved\\\", func(t *testing.T) {\\n+\\t\\tassertOneImportResolvedComputeEdge(t, pythonFFICallEdges(t, \\\"from frobnicate import\\\\\\\\\\\\n    compute\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"), \\\"app.py:function:plain\\\")\\n+\\t})\\n+\\n+\\tt.Run(\\\"parenthesized list needs no space after keyword\\\", func(t *testing.T) {\\n+\\t\\tassertOneImportResolvedComputeEdge(t, pythonFFICallEdges(t, \\\"from frobnicate import(compute)\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"), \\\"app.py:function:plain\\\")\\n+\\t})\\n+\\n+\\tt.Run(\\\"module name containing keyword is not split\\\", func(t *testing.T) {\\n+\\t\\tsrc := \\\"from importlib import compute\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"\\n+\\t\\tfn := pythonScopeCallable(t, src, \\\"app.py:function:plain\\\", \\\"function\\\", \\\"def plain\\\")\\n+\\t\\tif got := pythonScopeModules(t, src, []SymbolRecord{fn}, fn, \\\"compute\\\"); len(got) != 1 || got[0] != \\\"importlib\\\" {\\n+\\t\\t\\tt.Fatalf(\\\"got %#v, want importlib\\\", got)\\n+\\t\\t}\\n+\\t})\\n+\\n+\\tt.Run(\\\"star import binds no name\\\", func(t *testing.T) {\\n+\\t\\tsrc := \\\"from frobnicate import*\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"\\n+\\t\\tfn := pythonScopeCallable(t, src, \\\"app.py:function:plain\\\", \\\"function\\\", \\\"def plain\\\")\\n+\\t\\tif got := pythonScopeModules(t, src, []SymbolRecord{fn}, fn, \\\"compute\\\"); len(got) != 0 {\\n+\\t\\t\\tt.Fatalf(\\\"got %#v, want no binding\\\", got)\\n+\\t\\t}\\n+\\t\\timports := scanPythonImports(\\\"from mod import*\\\\n\\\")\\n+\\t\\tif len(imports) != 1 || imports[0] != \\\"mod\\\" {\\n+\\t\\t\\tt.Fatalf(\\\"scanPythonImports got %#v, want module mod\\\", imports)\\n+\\t\\t}\\n+\\t})\\n+\\n+\\tt.Run(\\\"multiline parenthesized list remains resolved\\\", func(t *testing.T) {\\n+\\t\\tassertOneImportResolvedComputeEdge(t, pythonFFICallEdges(t, \\\"from frobnicate import (\\\\n    compute,\\\\n)\\\\n\\\\ndef plain():\\\\n    return compute(1)\\\\n\\\"), \\\"app.py:function:plain\\\")\\n+\\t})\\n+\\n+\\tt.Run(\\\"malformed list does not consume a later valid import\\\", func(t *testing.T) {\\n+\\t\\tstatements := pythonFromImportStatements(\\\"from broken import (compute\\\\n\\\\nfrom frobnicate import compute\\\\n\\\")\\n+\\t\\tif len(statements) != 1 || statements[0].module != \\\"frobnicate\\\" {\\n+\\t\\t\\tt.Fatalf(\\\"got %#v, want the later valid import only\\\", statements)\\n+\\t\\t}\\n+\\t})\\n+}\\ndiff --git a/internal/sem/provider.go b/internal/sem/provider.go\\nindex 1bc8b796..94776454 100644\\n--- a/internal/sem/provider.go\\n+++ b/internal/sem/provider.go\\n@@ -20449,7 +20449,7 @@ type pythonFromImportStatement struct {\\n \\titems  []string\\n }\\n \\n-var pythonFromImportRE = regexp.MustCompile(`(?s)^from\\\\s+(\\\\.*(?:[A-Za-z_][A-Za-z0-9_\\\\.]*)?)\\\\s+import(?:[ \\\\t]+(.*))?$`)\\n+var pythonFromImportRE = regexp.MustCompile(`(?s)^from\\\\s+(\\\\.*(?:[A-Za-z_][A-Za-z0-9_\\\\.]*)?)(.*)$`)\\n \\n // pythonImportContinuationLines bounds how far a parenthesized import list is\\n // followed. A malformed unclosed list must not make scanning the rest of a\\n@@ -20525,7 +20525,20 @@ func pythonFromImportParts(text string) (module, items string, ok bool) {\\n \\tif len(matches) != 3 {\\n \\t\\treturn \\\"\\\", \\\"\\\", false\\n \\t}\\n-\\treturn strings.TrimSpace(matches[1]), matches[2], true\\n+\\tmodule = strings.TrimSpace(matches[1])\\n+\\trest := strings.TrimLeft(matches[2], \\\" \\\\t\\\\r\\\\n\\\")\\n+\\tif module == \\\"\\\" || !strings.HasPrefix(rest, \\\"import\\\") {\\n+\\t\\treturn \\\"\\\", \\\"\\\", false\\n+\\t}\\n+\\tafter := len(\\\"import\\\")\\n+\\tif after < len(rest) && isPythonImportNameByte(rest[after]) {\\n+\\t\\treturn \\\"\\\", \\\"\\\", false\\n+\\t}\\n+\\treturn module, rest[after:], true\\n+}\\n+\\n+func isPythonImportNameByte(b byte) bool {\\n+\\treturn b == '_' || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b >= 0x80\\n }\\n \\n func pythonImportParenDepth(items string) int {\\nok  \\tgithub.com/entireio/entire-graph/internal/sem\\t9.217s\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0690a-a093-7352-9a6c-ed6ea1d6d3c0","create_time":1788486195.577147}}}
