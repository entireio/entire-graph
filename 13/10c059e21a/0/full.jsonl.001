{"timestamp":"2026-09-04T01:23:18.363Z","ordinal":25488,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":92055271,"cached_input_tokens":91119872,"cache_write_input_tokens":0,"output_tokens":139981,"reasoning_output_tokens":75056,"total_tokens":92195252},"last_token_usage":{"input_tokens":161045,"cached_input_tokens":160384,"cache_write_input_tokens":0,"output_tokens":803,"reasoning_output_tokens":780,"total_tokens":161848},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1788748109},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"870.9511135000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
