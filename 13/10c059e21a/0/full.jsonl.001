{"timestamp":"2026-09-04T01:30:57.330Z","ordinal":25695,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":96970534,"cached_input_tokens":96011008,"cache_write_input_tokens":0,"output_tokens":146698,"reasoning_output_tokens":78212,"total_tokens":97117232},"last_token_usage":{"input_tokens":181496,"cached_input_tokens":179840,"cache_write_input_tokens":0,"output_tokens":1051,"reasoning_output_tokens":945,"total_tokens":182547},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1788748109},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"799.7724615000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
