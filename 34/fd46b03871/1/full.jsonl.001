n:\"kind\"`\n\tSignature     string `json:\"signature,omitempty\"`\n\tFilePath      string `json:\"file_path\"`","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"b8b0ae2d-481a-4118-a602-24017fc9abda","session_id":"0d4c4262-2100-4779-8745-e855e0a78208","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/entire-graph","sessionId":"73009f6a-a642-4aaa-8da3-51eb6bcc5b49","version":"2.1.220","gitBranch":"main","slug":"stateless-napping-unicorn"}
