le-b748ed       5      1      1\n  instance_ansible__ansible-f327e6       5      0      0\n  instance_internetarchive__openli       2      0      2\n  instance_internetarchive__openli       1      0      0\n  instance_qutebrowser__qutebrowse       3      0      0\n\n  TOTAL wanted=64  found@16KB=3 (5%)  found@64KB=7 (11%)\n  budget-fixable share: 6%   ranking-limited (still missing at 4x budget): 89%","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"91199049-ea90-4615-a273-fba8ba37d843","session_id":"0d4c4262-2100-4779-8745-e855e0a78208","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"73009f6a-a642-4aaa-8da3-51eb6bcc5b49","version":"2.1.220","gitBranch":"main","slug":"stateless-napping-unicorn"}
