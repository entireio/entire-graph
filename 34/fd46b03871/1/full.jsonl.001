 the winners' exploration counts do not rise.\n# At n=12 the token MDE is ~30pt against a same-instance noise floor of ~100pt, so no token\n# claim is made here regardless of which way it falls.\n#\n# Instances: the 12 with the highest BASELINE exploration volume -- where the mechanism operates.\n# Deliberately spans +71.0% (lombok-3674) to -127.4% (valkey-790) so loser repair and winner\n# regression are both tested in one cell.\nset -uo pipefail\nexport PATH=$PATH:$HOME/.local/bin:/usr/local/go/bin\n. \"$HOME/.authenv\"; export ANTHROPIC_AUTH_TOKEN\ncommand -v claude >/dev/null || { echo \"FATAL no claude on PATH\"; exit 1; }\ncd ~/work/graphmark/agentic-swebench\n\nBIN=\"$PWD/bin/entire-graph-linux.r3\"\n# PREFLIGHT. Every withdrawn headline on this suite died of a harness bug, and the two most recent\n# were capabilities that existed but were unreachable from the arm. Assert reachability, not\n# presence -- through eg-q, the way a session gets it.\n[ -x \"$BIN\" ] || { echo \"FATAL missing $BIN\"; exit 1; }\n\"$BIN\" def --brief x --repo . >/dev/null 2>&1 || { echo \"FATAL binary lacks --brief\"; exit 1; }\n\"$BIN\" search --query worktree --repo . --path internal >/dev/null 2>&1 || { echo \"FATAL binary lacks --path\"; exit 1; }\ngrep -q '\\-\\-path) \\[ \"\\$#\" -ge 2 \\]' tools/eg-q || { echo \"FATAL eg-q lacks --path passthrough\"; exit 1; }\ngrep -q 'EG_DEF_BRIEF_BYTES' tools/eg-q || { echo \"FATAL eg-q lacks the batched def form\"; exit 1; }\ngrep -q 'path <dir|file|glob>' tools/run_3arm.sh || { echo \"FATAL affordance not updated\"; exit 1; }\n# Reachability through the wrapper on a real repo, not just the binary in isolation.\nR=\"$PWD/$(ls -d repo-cache/* | head -1)\"\nWT=\"$R\" EGI=\"$BIN\" EG=\"$BIN\" CACHE=/tmp/egq-g3pre timeout 240 ./tools/eg-q def foo bar 2>&1 | grep -q '== foo ==' \\\n  || { echo \"FATAL batched def not reachable through eg-q\"; exit 1; }\necho \"[preflight] --path and batched def reachable through eg-q on $R\"\n\nexport ENTIRE_GR