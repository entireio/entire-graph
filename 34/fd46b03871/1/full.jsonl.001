4:\tenvPresearchAlias = \"EG_PRESEARCH\"\ninternal/cli/env.go:77:\t// PresearchPath is the file holding this session's pre-computed search payload, or \"\" when the\ninternal/cli/env.go:79:\tPresearchPath string\ninternal/cli/env.go:96:\t\tPresearchPath:   presearch,\ninternal/cli/search.go:134:\tif path := strings.TrimSpace(opts.Env.PresearchPath); path != \"\" {\ninternal/cli/search.go:135:\t\treturn echoPresearchPayload(opts.Stdout, path)\ninternal/cli/search.go:254:// echoPresearchPayload returns a payload that was computed before the agent started, verbatim.\ninternal/cli/search.go:286:func echoPresearchPayload(out interface{ Write([]byte) (int, error) }, path string) error {\n=== env wiring ===\n16:\t// envPresearch names a file holding the payload for this session, computed BEFORE the agent\n18:\t// echoPresearchPayload for the measurement that motivates it.\n20:\t// envPresearchAlias is the same knob under the prefix the benchmark harness already uses for\n23:\tenvPresearch      = \"ENTIRE_GRAPH_PRESEARCH\"\n24:\tenvPresearchAlias = \"EG_PRESEARCH\"\n77:\t// PresearchPath is the file holding this session's pre-computed search payload, or \"\" when the\n78:\t// caller has not pre-delivered one. See envPresearch.\n79:\tPresearchPath string\n87:\tpresearch := os.Getenv(envPresearch)\n89:\t\tpresearch = os.Getenv(envPresearchAlias)\n96:\t\tPresearchPath:   presearch,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"cec790d4-3c96-4115-b00e-f91286151595","session_id":"0d4c4262-2100-4779-8745-e855e0a78208","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/entire-graph","sessionId":"73009f6a-a642-4aaa-8da3-51eb6bcc5b49","version":"2.1.220","gitBranch":"main","slug":"stateless-napping-unicorn"}
