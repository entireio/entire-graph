n', 'repo_root', 'repo_key', 'commit', 'tree', 'languages', 'capabilities', 'schema_features', 'language_versions', 'profile', 'profile_limits', 'relation_set', 'skipped_relation_families', 'warnings', 'partial_failures', 'stats', 'completeness']\nTOTAL 36359\n  CALLS                    12636  34.75%\n  DEFINES                   7370  20.27%\n  SIMILAR_TO                3279   9.02%\n  DATA_FLOWS                3010   8.28%\n  USES_TYPE                 2303   6.33%\n  CONTAINS                  1870   5.14%\n  PARAM_TYPE                1606   4.42%\n  IMPORTS                   1100   3.03%\n  READS_FIELD                997   2.74%\n  RETURNS_TYPE               847   2.33%\n  FILE_CHANGES_WITH          378   1.04%\n  CONFIGURES                 297   0.82%\n  WRITES_FIELD               209   0.57%\n  HANDLES_GRAPHQL            207   0.57%\n  HTTP_CALLS                  70   0.19%\n  HANDLES_ROUTE               48   0.13%\n  ACCESSES                    34   0.09%\n  CONSTRUCTS                  32   0.09%\n  OVERRIDES                   10   0.03%\n  TESTS                       10   0.03%\n  EXTENDS                      9   0.02%\n  INHERITS                     9   0.02%\n  HANDLES_TOOL                 7   0.02%\n  IMPLEMENTS                   7   0.02%\n  RESOURCE_DEPENDS_ON          6   0.02%\n  EMITS                        3   0.01%\n  LISTENS_ON                   2   0.01%\n  ASYNC_CALLS                  1   0.00%\n  HANDLES_TRPC                 1   0.00%\n  HANDLES_GRPC                 1   0.00%","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"97e30fc3-aee1-4081-8104-b531a96e13de","session_id":"0d4c4262-2100-4779-8745-e855e0a78208","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/entire-graph","sessionId":"73009f6a-a642-4aaa-8da3-51eb6bcc5b49","version":"2.1.220","gitBranch":"main","slug":"stateless-napping-unicorn"}
