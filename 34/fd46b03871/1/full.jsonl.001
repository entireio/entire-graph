k|pubspec\\.lock)\"\n)\n\n_RX = re.compile(\n    # --- vendored subtree, anchored at a path-component boundary ---------------------------\n    r\"(?:^|/)\" + _VENDOR_DIR + r\"/\"\n    # --- minified bundles and source maps --------------------------------------------------\n    r\"|\\.min\\.(?:js|mjs|cjs|css)$\"\n    r\"|\\.map$\"\n    # --- lockfiles, anchored so a repo-relative or nested path both match -------------------\n    r\"|(?:^|/)\" + _LOCKFILES + r\"$\"\n)\n\n\ndef isvendor(path: str) -> bool:\n    \"\"\"True when a grep hit at this path is vendored, minified or a lockfile.\n\n    `path` is repo-relative, matching how tools/_istest.py is called.\n    \"\"\"\n    if not path:\n        return False\n    return _RX.search(path.replace(\"\\\\\", \"/\")) is not None\n\n\n# A single physical line this long with no whitespace is minified regardless of its path — this\n# catches generated bundles that live outside any vendor directory. Deliberately generous: real\n# source lines run long (URLs, base64 fixtures, long string literals), and a false positive here\n# suppresses a hit, so the bar is set where only machine-generated output clears it.\n_MINIFIED_LINE_CHARS = 400\n\n\ndef isminified_line(text: str) -> bool:\n    \"\"\"True when the matched LINE itself looks machine-generated rather than authored.\"\"\"\n    if len(text) < _MINIFIED_LINE_CHARS:\n        return False\n    # Authored code of this length still breaks into words; minified output does not.\n    return (text.count(\" \") / len(text)) < 0.02\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"f793cddc-d069-4562-8126-5a2d3ffcf0f1","session_id":"0d4c4262-2100-4779-8745-e855e0a78208","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"73009f6a-a642-4aaa-8da3-51eb6bcc5b49","version":"2.1.220","gitBranch":"main","slug":"stateless-napping-unicorn"}
